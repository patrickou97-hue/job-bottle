.support-tabs {
  margin-top: 30rpx;
}

.category-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 12rpx;
}

.category-button {
  min-height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 58rpx;
}

.category-button-active {
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.support-loading,
.guide-list {
  margin-top: 28rpx;
}

.support-skeleton {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.support-skeleton-short {
  width: 58%;
  margin-top: 18rpx;
}

.guide-item {
  display: block;
  width: 100%;
  padding: 28rpx 2rpx;
  border-bottom: 1rpx solid var(--color-line);
  background: transparent;
  text-align: left;
}

.guide-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.guide-category,
.guide-pinned {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-accent-soft);
  color: #57558b;
}

.guide-pinned {
  background: #f3e9dd;
  color: #7a552b;
}

.guide-date {
  margin-left: auto;
}

.guide-title,
.guide-content,
.guide-toggle {
  display: block;
}

.web-tools {
  margin-top: 54rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-line);
}

.web-tools-kicker,
.web-tools-title,
.web-tool-title,
.web-tool-body,
.web-tool-action {
  display: block;
}

.web-tools-kicker {
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
}

.web-tools-title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 680;
}

.web-tool {
  display: block;
  width: 100%;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: #fff;
  color: var(--color-ink);
  text-align: left;
}

.web-tool-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.web-tool-title {
  font-size: 27rpx;
  font-weight: 680;
}

.web-tool-platform {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-accent-soft);
  color: #57558b;
  font-size: 19rpx;
}

.web-tool-body {
  margin-top: 12rpx;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  line-height: 1.65;
}

.web-tool-action {
  margin-top: 13rpx;
  color: var(--color-navy);
  font-size: 22rpx;
  font-weight: 650;
}

.guide-title {
  margin-top: 16rpx;
  font-size: 31rpx;
  font-weight: 680;
  line-height: 1.35;
}

.guide-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: var(--color-ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.guide-content-expanded {
  display: block;
  overflow: visible;
}

.guide-toggle {
  margin-top: 14rpx;
  color: var(--color-navy);
  font-size: 23rpx;
  font-weight: 620;
}

.workflow-panel {
  margin-top: 30rpx;
  border-top: 1rpx solid var(--color-line);
}

.workflow-step {
  border-bottom: 1rpx solid var(--color-line);
}

.workflow-step-head {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  gap: 18rpx;
  background: transparent;
  color: var(--color-ink);
  text-align: left;
}

.workflow-step-index {
  display: grid;
  width: 42rpx;
  height: 42rpx;
  place-items: center;
  border: 1rpx solid var(--color-line);
  border-radius: 50%;
  color: var(--color-muted);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.workflow-step-title {
  min-width: 0;
  flex: 1;
  font-size: 29rpx;
  font-weight: 680;
}

.workflow-step-toggle {
  color: var(--color-muted);
  font-size: 35rpx;
  font-weight: 300;
}

.workflow-step-body {
  padding: 0 0 30rpx 60rpx;
}

.workflow-step-copy {
  display: block;
  color: var(--color-ink-soft);
  font-size: 24rpx;
  line-height: 1.75;
}

.workflow-step-action {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0;
  background: transparent;
  color: var(--color-navy);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
  text-align: left;
}

.feedback-panel {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 680;
}

.feedback-types {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.feedback-type {
  min-height: 62rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 31rpx;
  background: transparent;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  line-height: 62rpx;
}

.feedback-type-active {
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: #fff;
}

.feedback-field {
  display: block;
  margin-top: 36rpx;
}

.feedback-helper,
.privacy-copy,
.feedback-message {
  display: block;
}

.feedback-helper {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 280rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: #fff;
  font-size: 27rpx;
  line-height: 1.6;
}

.feedback-message {
  margin-top: 18rpx;
  color: var(--color-ink-soft);
  font-size: 24rpx;
}

.feedback-submit {
  margin-top: 24rpx;
}

.privacy-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}
