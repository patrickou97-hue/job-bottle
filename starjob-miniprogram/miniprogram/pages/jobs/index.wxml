<view class="jobs-page">
  <view class="hero">
    <view
      class="brand-row"
      style="margin-top: {{menuTop}}px; height: {{menuHeight}}px; max-width: {{menuLeft - 32}}px;"
    >
      <image
        class="brand-wordmark"
        src="/assets/shi-xing-wordmark.png"
        mode="aspectFit"
      />
      <text class="brand-subtitle">STARJOB</text>
      <text class="source-note" wx:if="{{isSampleData}}">界面样例</text>
    </view>

    <view class="title-row">
      <view>
        <text class="hero-title">岗位坐标</text>
        <text class="hero-description">找到值得认真投递的下一站</text>
        <text class="hero-meta" wx:if="{{!loading && !errorMessage}}">{{jobs.length}} 个开放岗位</text>
      </view>
    </view>

    <view class="search-field">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索公司或岗位"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
      />
    </view>
  </view>

  <view class="filter-section">
    <scroll-view class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-row">
        <button
          wx:for="{{cityOptions}}"
          wx:key="*this"
          class="filter-chip {{selectedCity === item ? 'filter-chip-active' : ''}}"
          data-city="{{item}}"
          bindtap="onCityTap"
        >
          {{item}}
        </button>
      </view>
    </scroll-view>

    <scroll-view class="chip-scroll category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-row">
        <button
          wx:for="{{categoryOptions}}"
          wx:key="*this"
          class="filter-chip filter-chip-secondary {{selectedCategory === item ? 'filter-chip-active' : ''}}"
          data-category="{{item}}"
          bindtap="onCategoryTap"
        >
          {{item}}
        </button>
      </view>
    </scroll-view>

    <scroll-view class="chip-scroll category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-row">
        <button
          wx:for="{{batchOptions}}"
          wx:key="*this"
          class="filter-chip filter-chip-secondary {{selectedBatch === item ? 'filter-chip-active' : ''}}"
          data-batch="{{item}}"
          bindtap="onBatchTap"
        >
          {{item === '全部' ? '全部批次' : item}}
        </button>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="discovery-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="discovery-row">
      <button class="discovery-button {{scope === 'all' ? 'discovery-button-active' : ''}}" data-scope="all" bindtap="onScopeTap">全部岗位</button>
      <button class="discovery-button {{scope === 'recent' ? 'discovery-button-active' : ''}}" data-scope="recent" bindtap="onScopeTap">近 7 天</button>
      <button wx:if="{{preferenceAvailable}}" class="discovery-button {{scope === 'recent_preference' ? 'discovery-button-active' : ''}}" data-scope="recent_preference" bindtap="onScopeTap">近期适合我</button>
    </view>
  </scroll-view>

  <view class="result-header">
    <view class="scope-switch">
      <button class="scope-button {{jobView === 'all' ? 'scope-button-active' : ''}}" data-view="all" bindtap="onJobViewTap">全部</button>
      <button class="scope-button {{jobView === 'unapplied' ? 'scope-button-active' : ''}}" data-view="unapplied" bindtap="onJobViewTap">未收录</button>
      <button class="scope-button {{jobView === 'applied' ? 'scope-button-active' : ''}}" data-view="applied" bindtap="onJobViewTap">已收录 {{savedCount}}</button>
    </view>
    <view class="view-switch">
      <button class="view-button {{viewMode === 'map' ? 'view-button-active' : ''}}" data-mode="map" bindtap="onViewModeTap">地图</button>
      <button class="view-button {{viewMode === 'list' ? 'view-button-active' : ''}}" data-mode="list" bindtap="onViewModeTap">列表</button>
    </view>
  </view>

  <view class="job-list" wx:if="{{loading}}">
    <view class="job-skeleton" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-line skeleton-company"></view>
      <view class="skeleton-line skeleton-role"></view>
      <view class="skeleton-line skeleton-meta"></view>
    </view>
  </view>

  <view class="state-panel" wx:elif="{{errorMessage}}">
    <text class="state-title">岗位暂时没有加载出来</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button state-action" bindtap="onRetry">重新加载</button>
  </view>

  <view class="state-panel" wx:elif="{{jobs.length === 0}}">
    <text class="state-title">没有符合条件的岗位</text>
    <text class="state-copy">换一个城市、方向或关键词再试试。</text>
  </view>

  <view class="map-layout" wx:elif="{{viewMode === 'map'}}">
    <view class="map-shell surface-card">
      <map
        class="job-map"
        latitude="35.2"
        longitude="104.2"
        scale="4"
        min-scale="3"
        max-scale="12"
        markers="{{markers}}"
        bindmarkertap="onMarkerTap"
        show-location="{{false}}"
        enable-zoom
        enable-scroll
      />
      <view class="map-caption">
        <view>
          <text class="map-caption-title">{{selectedCity === '全部' ? '全国岗位分布' : selectedCity + '岗位'}}</text>
          <text class="map-caption-copy">点击城市坐标筛选，地图与岗位清单同步。</text>
        </view>
        <text class="result-count">{{jobs.length}} 个结果</text>
      </view>
    </view>

    <view class="map-list-heading">
      <view>
        <text class="map-list-title">{{selectedCity === '全部' ? '全部匹配岗位' : selectedCity + '岗位'}}</text>
        <text class="map-list-subtitle">{{jobs.length}} 个匹配结果，继续下滑浏览</text>
      </view>
    </view>

    <view class="map-job-list">
      <button
        wx:for="{{jobs}}"
        wx:key="id"
        class="map-job-row"
        data-id="{{item.id}}"
        bindtap="onJobTap"
      >
        <view class="map-job-index">{{index + 1}}</view>
        <view class="map-job-content">
          <text class="company-name">{{item.companyName}}</text>
          <text class="job-title">{{item.jobTitles}}</text>
          <text class="job-meta">{{item.locations}} · {{item.categoryLabel}}{{item.applicationLabel ? ' · ' + item.applicationLabel : ''}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="job-list" wx:else>
    <button
      wx:for="{{jobs}}"
      wx:key="id"
      class="job-row"
      data-id="{{item.id}}"
      bindtap="onJobTap"
      hover-class="job-row-pressed"
    >
      <view class="job-main">
        <view class="job-heading">
          <text class="company-name">{{item.companyName}}</text>
          <text class="recent-dot" wx:if="{{item.isRecent}}">新</text>
          <text class="fit-badge" wx:if="{{item.preferenceMatched}}">匹配偏好</text>
        </view>
        <text class="job-title">{{item.jobTitles}}</text>
        <view class="job-meta">
          <text>{{item.locations}}</text>
          <text class="meta-divider">·</text>
          <text>{{item.categoryLabel}}</text>
          <text class="meta-divider">·</text>
          <text>{{item.batchType}}</text>
        </view>
      </view>
      <view class="job-side">
        <text class="application-state" wx:if="{{item.applicationLabel}}">{{item.applicationLabel}}</text>
        <text class="open-date">{{item.openDateLabel}}</text>
        <text class="row-arrow">›</text>
      </view>
    </button>
  </view>
</view>
