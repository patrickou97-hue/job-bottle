page {
  background: #071429;
}

.jobs-page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--color-paper);
}

.hero {
  padding: 0 32rpx 34rpx;
  background: #071429;
  color: #f1efff;
}

.brand-row {
  display: flex;
  align-items: center;
  min-height: 32px;
  transform: translateY(12rpx);
}

.back-button {
  display: flex;
  width: 60rpx;
  min-width: 60rpx;
  height: 60rpx;
  margin-right: 8rpx;
  padding: 0 0 5rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(241, 239, 255, 0.08);
  color: rgba(241, 239, 255, 0.88);
  font-size: 43rpx;
  font-weight: 400;
  line-height: 1;
}

.back-button-pressed {
  background: rgba(241, 239, 255, 0.16);
}

.brand-wordmark {
  width: 134rpx;
  height: 60rpx;
}

.brand-subtitle {
  margin-left: 18rpx;
  color: rgba(201, 197, 228, 0.56);
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 5rpx;
}

.source-note {
  margin-left: auto;
  color: rgba(201, 197, 228, 0.62);
  font-size: 21rpx;
}

.title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 48rpx;
}

.hero-title,
.hero-description,
.hero-meta {
  display: block;
}

.hero-title {
  font-size: 54rpx;
  font-weight: 710;
  letter-spacing: -2rpx;
  line-height: 1.12;
}

.hero-description {
  margin-top: 12rpx;
  color: rgba(201, 197, 228, 0.72);
  font-size: 26rpx;
}

.hero-meta {
  margin-top: 16rpx;
  color: rgba(201, 197, 228, 0.52);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.search-field {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(231, 226, 255, 0.15);
  border-radius: 18rpx;
  background: rgba(241, 239, 255, 0.08);
}

.search-input {
  flex: 1;
  height: 84rpx;
  color: #f1efff;
  font-size: 28rpx;
}

.search-placeholder {
  color: rgba(145, 140, 174, 0.78);
}

.filter-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  background: var(--color-surface);
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-scroll {
  margin-top: 14rpx;
}

.chip-row {
  display: inline-flex;
  gap: 10rpx;
  padding: 0 32rpx;
}

.filter-chip {
  min-width: auto;
  min-height: 68rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: var(--color-surface-strong);
  color: var(--color-ink-soft);
  font-size: 24rpx;
  line-height: 66rpx;
}

.filter-chip-secondary {
  min-height: 68rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 66rpx;
}

.filter-chip-active {
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: #fff;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 32rpx 18rpx;
}

.discovery-scroll {
  width: 100%;
  padding-top: 20rpx;
  background: var(--color-bg);
  white-space: nowrap;
}

.discovery-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.discovery-button {
  min-height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 60rpx;
}

.discovery-button-active {
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.scope-switch {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 14rpx;
  background: #dddfe4;
}

.scope-button {
  min-width: 92rpx;
  min-height: 64rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 64rpx;
}

.scope-button-active {
  background: var(--color-surface-strong);
  color: var(--color-ink);
  font-weight: 650;
  box-shadow: 0 2rpx 5rpx rgba(18, 41, 78, 0.08);
}

.view-switch {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 14rpx;
  background: #dddfe4;
}

.view-button {
  min-width: 68rpx;
  min-height: 64rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 64rpx;
}

.view-button-active {
  background: var(--color-surface-strong);
  color: var(--color-ink);
  font-weight: 640;
}

.map-layout {
  padding: 0 32rpx;
}

.map-shell {
  overflow: hidden;
}

.job-map {
  width: 100%;
  height: 620rpx;
}

.map-caption {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
}

.map-caption-title,
.map-caption-copy {
  display: block;
}

.map-caption-title {
  font-size: 28rpx;
  font-weight: 670;
}

.map-caption-copy {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.result-count {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.map-job-list,
.job-list {
  margin-top: 18rpx;
}

.map-list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
}

.map-list-title,
.map-list-subtitle {
  display: block;
}

.map-list-title {
  font-size: 29rpx;
  font-weight: 670;
}

.map-list-subtitle {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.job-list {
  padding: 0 32rpx;
}

.map-job-row,
.job-row {
  width: 100%;
  border-bottom: 1rpx solid var(--color-line);
  border-radius: 0;
  background: transparent;
  color: var(--color-ink);
  text-align: left;
}

.map-job-row {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 22rpx 4rpx;
}

.map-job-index {
  flex: 0 0 42rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.map-job-content {
  min-width: 0;
  flex: 1;
}

.job-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  min-height: 174rpx;
  padding: 28rpx 0;
}

.job-row-pressed {
  opacity: 0.62;
}

.job-main {
  min-width: 0;
  flex: 1;
}

.job-heading {
  display: flex;
  align-items: center;
  min-width: 0;
}

.company-name {
  overflow: hidden;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  font-weight: 630;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-dot {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: var(--color-warm);
  font-size: 20rpx;
  font-weight: 700;
}

.fit-badge {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(18, 41, 78, 0.08);
  color: var(--color-navy);
  font-size: 18rpx;
  font-weight: 650;
}

.job-title {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 670;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-meta {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-divider {
  margin: 0 9rpx;
  color: #b7b7bc;
}

.job-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  margin-left: 24rpx;
}

.application-state {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(201, 151, 60, 0.12);
  color: #8a5d18;
  font-size: 18rpx;
  font-weight: 650;
  white-space: nowrap;
}

.open-date {
  color: var(--color-muted);
  font-size: 20rpx;
  white-space: nowrap;
  line-height: 1.45;
  text-align: right;
}

.row-arrow {
  color: #a1a1a6;
  font-size: 38rpx;
  line-height: 1;
}

.state-panel {
  margin: 40rpx 32rpx 0;
  padding: 48rpx 24rpx;
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
  text-align: center;
}

.state-title,
.state-copy {
  display: block;
}

.state-title {
  font-size: 30rpx;
  font-weight: 660;
}

.state-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.state-action {
  width: 240rpx;
  margin: 28rpx auto 0;
}

.job-skeleton {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.skeleton-company {
  width: 28%;
}

.skeleton-role {
  width: 72%;
  height: 32rpx;
  margin-top: 16rpx;
}

.skeleton-meta {
  width: 48%;
  margin-top: 20rpx;
}
