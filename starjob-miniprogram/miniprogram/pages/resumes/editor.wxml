<template name="item-actions">
  <view class="item-actions">
    <button class="item-action" data-section="{{section}}" data-index="{{index}}" data-direction="-1" bindtap="onMoveItem" disabled="{{index === 0}}">上移</button>
    <button class="item-action" data-section="{{section}}" data-index="{{index}}" data-direction="1" bindtap="onMoveItem" disabled="{{index === length - 1}}">下移</button>
    <button class="item-action item-action-danger" data-section="{{section}}" data-index="{{index}}" bindtap="onRemoveItem">删除</button>
  </view>
</template>

<template name="text-section-list">
  <view class="editor-list">
    <view class="editor-card" wx:for="{{items}}" wx:key="id">
      <template is="item-actions" data="{{section: sectionKey, index, length: items.length}}" />
      <label class="editor-field">
        <text class="editor-label">标题</text>
        <input class="editor-input" value="{{item.title}}" data-path="resume.content.{{sectionKey}}[{{index}}].title" bindinput="onFieldInput" maxlength="160" />
      </label>
      <label class="editor-field" wx:if="{{showRole}}">
        <text class="editor-label">职责（可选）</text>
        <input class="editor-input" value="{{item.role}}" data-path="resume.content.{{sectionKey}}[{{index}}].role" bindinput="onFieldInput" maxlength="180" placeholder="例如：负责人、核心成员" />
      </label>
      <label class="editor-field" wx:if="{{showDate}}">
        <text class="editor-label">时间（可选）</text>
        <input class="editor-input" value="{{item.date}}" data-path="resume.content.{{sectionKey}}[{{index}}].date" bindinput="onFieldInput" maxlength="80" placeholder="例如：2024.09—2025.06" />
      </label>
      <label class="editor-field">
        <text class="editor-label">内容</text>
        <textarea class="editor-textarea editor-textarea-large" value="{{item.bulletsText}}" data-path="resume.content.{{sectionKey}}[{{index}}].bulletsText" bindinput="onFieldInput" placeholder="每行一条内容" maxlength="6000" auto-height />
      </label>
      <button class="polish-trigger" data-section="{{sectionKey}}" data-index="{{index}}" bindtap="onPolishItem">智能润色这段内容</button>
    </view>
    <button class="add-section-button" data-section="{{sectionKey}}" bindtap="onAddItem">＋ 添加{{sectionLabel}}</button>
  </view>
</template>

<view class="resume-editor-page">
  <view class="editor-loading" wx:if="{{loading}}">
    <view class="skeleton-line editor-skeleton-title"></view>
    <view class="skeleton-line editor-skeleton-block"></view>
    <view class="skeleton-line editor-skeleton-block"></view>
  </view>

  <view class="state-panel editor-error-state" wx:elif="{{errorMessage && !resume}}">
    <text class="state-title">简历暂时无法打开</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button state-action" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:elif="{{resume}}">
    <view class="editor-toolbar">
      <view class="editor-title-copy">
        <text class="editor-title">{{resume.title || '未命名简历'}}</text>
        <text class="editor-status {{dirty ? 'editor-status-dirty' : ''}}">{{aiTaskKind === 'translate' ? '正在生成译本…' : saving ? '正在保存…' : dirty ? '有未保存修改' : '已同步云端'}}</text>
      </view>
      <view class="toolbar-actions">
        <button class="toolbar-button" disabled="{{!!aiTaskKind}}" bindtap="onPreview">预览</button>
        <button class="toolbar-button toolbar-more" disabled="{{!!aiTaskKind}}" bindtap="onMoreActions">•••</button>
        <button class="toolbar-save" loading="{{saving}}" disabled="{{saving || !!aiTaskKind || !dirty}}" bindtap="onSave">保存</button>
      </view>
    </view>

    <view class="ai-task-panel" wx:if="{{aiTaskKind === 'translate'}}" aria-role="progressbar" aria-label="{{aiTaskStage}}，已用 {{aiTaskElapsedSeconds}} 秒">
      <view class="ai-task-copy">
        <view>
          <text class="ai-task-title">{{aiTaskStage}}</text>
          <text class="ai-task-helper">已用 {{aiTaskElapsedSeconds}} 秒，完成后会新建译本</text>
        </view>
      </view>
      <view class="ai-task-track"><view class="ai-task-fill"></view></view>
      <button class="ai-task-cancel" bindtap="onCancelAiTask">取消本次翻译</button>
    </view>

    <scroll-view class="section-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="section-tabs">
        <button
          wx:for="{{sectionOptions}}"
          wx:key="id"
          class="section-tab {{activeSection === item.id ? 'section-tab-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSectionTap"
        >{{item.label}}</button>
      </view>
    </scroll-view>

    <view class="editor-error" wx:if="{{errorMessage}}">
      <text>{{errorMessage}}</text>
    </view>

    <view class="editor-section" wx:if="{{activeSection === 'overview'}}">
      <view class="section-heading">
        <text class="section-heading-title">简历设置</text>
        <text class="section-heading-copy">名称、目标岗位和版式会同步到网页版。</text>
      </view>
      <view class="editor-card">
        <label class="editor-field">
          <text class="editor-label">简历名称</text>
          <input class="editor-input" value="{{resume.title}}" data-path="resume.title" bindinput="onFieldInput" maxlength="80" />
        </label>
        <label class="editor-field">
          <text class="editor-label">目标岗位</text>
          <input class="editor-input" value="{{resume.targetRole}}" data-path="resume.targetRole" bindinput="onFieldInput" maxlength="120" />
        </label>
        <label class="editor-field">
          <text class="editor-label">求职目标补充</text>
          <textarea class="editor-textarea" value="{{resume.jobTarget}}" data-path="resume.jobTarget" bindinput="onFieldInput" maxlength="240" auto-height />
        </label>
      </view>
      <view class="section-heading section-heading-compact">
        <text class="section-heading-title">版式</text>
      </view>
      <view class="template-grid">
        <button
          wx:for="{{templateOptions}}"
          wx:key="id"
          class="template-option {{resume.templateId === item.id ? 'template-option-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTemplateTap"
        >{{item.label}}</button>
      </view>
      <view class="section-heading section-heading-compact">
        <text class="section-heading-title">模块排序</text>
        <text class="section-heading-copy">会同步影响网页版、A4 预览和 PDF 的模块顺序。</text>
      </view>
      <view class="section-order-list">
        <view
          class="section-order-row"
          wx:for="{{resume.content.sectionOrder}}"
          wx:key="*this"
        >
          <text class="section-order-index">{{index + 1}}</text>
          <text class="section-order-label">{{sectionOrderLabels[item]}}</text>
          <view class="section-order-actions">
            <button class="item-action" data-index="{{index}}" data-direction="-1" bindtap="onMoveSection" disabled="{{index === 0}}">上移</button>
            <button class="item-action" data-index="{{index}}" data-direction="1" bindtap="onMoveSection" disabled="{{index === resume.content.sectionOrder.length - 1}}">下移</button>
          </view>
        </view>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'basics'}}">
      <view class="section-heading">
        <text class="section-heading-title">基本信息</text>
        <text class="section-heading-copy">只填写你愿意展示在简历上的联系方式。</text>
      </view>
      <view class="photo-field">
        <view class="photo-preview">
          <image wx:if="{{resume.content.basics.photoDataUrl}}" class="photo-image" src="{{resume.content.basics.photoDataUrl}}" mode="aspectFill" />
          <text wx:else class="photo-placeholder">证件照</text>
        </view>
        <view class="photo-actions">
          <text class="editor-label">简历照片（可选）</text>
          <text class="photo-helper">仅用于支持照片的中文模板，压缩后随简历同步。</text>
          <view class="photo-buttons">
            <button class="item-action photo-button" bindtap="onChoosePhoto">{{resume.content.basics.photoDataUrl ? '更换照片' : '选择照片'}}</button>
            <button wx:if="{{resume.content.basics.photoDataUrl}}" class="item-action item-action-danger photo-button" bindtap="onRemovePhoto">移除</button>
          </view>
        </view>
      </view>
      <view class="editor-card">
        <label class="editor-field"><text class="editor-label">姓名</text><input class="editor-input" value="{{resume.content.basics.name}}" data-path="resume.content.basics.name" bindinput="onFieldInput" maxlength="80" /></label>
        <label class="editor-field"><text class="editor-label">英文名</text><input class="editor-input" value="{{resume.content.basics.englishName}}" data-path="resume.content.basics.englishName" bindinput="onFieldInput" maxlength="120" /></label>
        <label class="editor-field"><text class="editor-label">手机号</text><input class="editor-input" value="{{resume.content.basics.phone}}" data-path="resume.content.basics.phone" bindinput="onFieldInput" maxlength="40" /></label>
        <label class="editor-field"><text class="editor-label">邮箱</text><input class="editor-input" value="{{resume.content.basics.email}}" data-path="resume.content.basics.email" bindinput="onFieldInput" maxlength="160" /></label>
        <label class="editor-field"><text class="editor-label">所在城市</text><input class="editor-input" value="{{resume.content.basics.city}}" data-path="resume.content.basics.city" bindinput="onFieldInput" maxlength="80" /></label>
        <label class="editor-field"><text class="editor-label">简历内目标岗位</text><input class="editor-input" value="{{resume.content.basics.targetRole}}" data-path="resume.content.basics.targetRole" bindinput="onFieldInput" maxlength="120" /></label>
        <label class="editor-field"><text class="editor-label">LinkedIn</text><input class="editor-input" value="{{resume.content.basics.linkedin}}" data-path="resume.content.basics.linkedin" bindinput="onFieldInput" maxlength="240" /></label>
        <label class="editor-field"><text class="editor-label">GitHub</text><input class="editor-input" value="{{resume.content.basics.github}}" data-path="resume.content.basics.github" bindinput="onFieldInput" maxlength="240" /></label>
        <label class="editor-field"><text class="editor-label">个人网站</text><input class="editor-input" value="{{resume.content.basics.website}}" data-path="resume.content.basics.website" bindinput="onFieldInput" maxlength="240" /></label>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'education'}}">
      <view class="section-heading"><text class="section-heading-title">教育经历</text><text class="section-heading-copy">时间可以留空，空记录不会出现在预览中。</text></view>
      <view class="editor-list">
        <view class="editor-card" wx:for="{{resume.content.education}}" wx:key="id">
          <template is="item-actions" data="{{section: 'education', index, length: resume.content.education.length}}" />
          <label class="editor-field"><text class="editor-label">学校</text><input class="editor-input" value="{{item.school}}" data-path="resume.content.education[{{index}}].school" bindinput="onFieldInput" /></label>
          <view class="field-pair">
            <label class="editor-field"><text class="editor-label">学历</text><input class="editor-input" value="{{item.degree}}" data-path="resume.content.education[{{index}}].degree" bindinput="onFieldInput" /></label>
            <label class="editor-field"><text class="editor-label">专业</text><input class="editor-input" value="{{item.major}}" data-path="resume.content.education[{{index}}].major" bindinput="onFieldInput" /></label>
          </view>
          <view class="field-pair">
            <label class="editor-field"><text class="editor-label">开始时间（可选）</text><input class="editor-input" value="{{item.startDate}}" data-path="resume.content.education[{{index}}].startDate" bindinput="onFieldInput" /></label>
            <label class="editor-field"><text class="editor-label">结束时间（可选）</text><input class="editor-input" value="{{item.endDate}}" data-path="resume.content.education[{{index}}].endDate" bindinput="onFieldInput" /></label>
          </view>
          <label class="editor-field"><text class="editor-label">GPA</text><input class="editor-input" value="{{item.gpa}}" data-path="resume.content.education[{{index}}].gpa" bindinput="onFieldInput" /></label>
          <label class="editor-field"><text class="editor-label">主修课程</text><textarea class="editor-textarea" value="{{item.courses}}" data-path="resume.content.education[{{index}}].courses" bindinput="onFieldInput" auto-height /></label>
          <label class="editor-field"><text class="editor-label">荣誉</text><textarea class="editor-textarea" value="{{item.honors}}" data-path="resume.content.education[{{index}}].honors" bindinput="onFieldInput" auto-height /></label>
        </view>
        <button class="add-section-button" data-section="education" bindtap="onAddItem">＋ 添加教育经历</button>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'work'}}">
      <view class="section-heading"><text class="section-heading-title">实习与工作经历</text><text class="section-heading-copy">每行填写一条职责或成果。</text></view>
      <view class="editor-list">
        <view class="editor-card" wx:for="{{resume.content.work}}" wx:key="id">
          <template is="item-actions" data="{{section: 'work', index, length: resume.content.work.length}}" />
          <label class="editor-field"><text class="editor-label">公司</text><input class="editor-input" value="{{item.company}}" data-path="resume.content.work[{{index}}].company" bindinput="onFieldInput" /></label>
          <view class="field-pair">
            <label class="editor-field"><text class="editor-label">岗位</text><input class="editor-input" value="{{item.title}}" data-path="resume.content.work[{{index}}].title" bindinput="onFieldInput" /></label>
            <label class="editor-field"><text class="editor-label">地点</text><input class="editor-input" value="{{item.location}}" data-path="resume.content.work[{{index}}].location" bindinput="onFieldInput" /></label>
          </view>
          <view class="field-pair">
            <label class="editor-field"><text class="editor-label">开始时间（可选）</text><input class="editor-input" value="{{item.startDate}}" data-path="resume.content.work[{{index}}].startDate" bindinput="onFieldInput" /></label>
            <label class="editor-field"><text class="editor-label">结束时间（可选）</text><input class="editor-input" value="{{item.endDate}}" data-path="resume.content.work[{{index}}].endDate" bindinput="onFieldInput" disabled="{{item.current}}" /></label>
          </view>
          <checkbox-group data-index="{{index}}" bindchange="onCurrentChange"><label class="current-check"><checkbox value="current" checked="{{item.current}}" color="#12294e" />目前仍在这里</label></checkbox-group>
          <label class="editor-field"><text class="editor-label">工作内容与成果</text><textarea class="editor-textarea editor-textarea-large" value="{{item.bulletsText}}" data-path="resume.content.work[{{index}}].bulletsText" bindinput="onFieldInput" placeholder="每行一条经历描述" maxlength="6000" auto-height /></label>
          <button class="polish-trigger" data-section="work" data-index="{{index}}" bindtap="onPolishItem">智能润色这段经历</button>
        </view>
        <button class="add-section-button" data-section="work" bindtap="onAddItem">＋ 添加工作经历</button>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'projects'}}">
      <view class="section-heading"><text class="section-heading-title">项目经历</text><text class="section-heading-copy">突出你的角色、行动和可量化结果。</text></view>
      <view class="editor-list">
        <view class="editor-card" wx:for="{{resume.content.projects}}" wx:key="id">
          <template is="item-actions" data="{{section: 'projects', index, length: resume.content.projects.length}}" />
          <label class="editor-field"><text class="editor-label">项目名称</text><input class="editor-input" value="{{item.name}}" data-path="resume.content.projects[{{index}}].name" bindinput="onFieldInput" /></label>
          <label class="editor-field"><text class="editor-label">你的角色</text><input class="editor-input" value="{{item.role}}" data-path="resume.content.projects[{{index}}].role" bindinput="onFieldInput" /></label>
          <view class="field-pair">
            <label class="editor-field"><text class="editor-label">开始时间（可选）</text><input class="editor-input" value="{{item.startDate}}" data-path="resume.content.projects[{{index}}].startDate" bindinput="onFieldInput" /></label>
            <label class="editor-field"><text class="editor-label">结束时间（可选）</text><input class="editor-input" value="{{item.endDate}}" data-path="resume.content.projects[{{index}}].endDate" bindinput="onFieldInput" /></label>
          </view>
          <label class="editor-field"><text class="editor-label">关键词</text><input class="editor-input" value="{{item.keywords}}" data-path="resume.content.projects[{{index}}].keywords" bindinput="onFieldInput" /></label>
          <label class="editor-field"><text class="editor-label">项目内容与成果</text><textarea class="editor-textarea editor-textarea-large" value="{{item.bulletsText}}" data-path="resume.content.projects[{{index}}].bulletsText" bindinput="onFieldInput" placeholder="每行一条项目描述" maxlength="6000" auto-height /></label>
          <button class="polish-trigger" data-section="projects" data-index="{{index}}" bindtap="onPolishItem">智能润色这段项目</button>
        </view>
        <button class="add-section-button" data-section="projects" bindtap="onAddItem">＋ 添加项目经历</button>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'skills'}}">
      <view class="section-heading"><text class="section-heading-title">技能</text><text class="section-heading-copy">用顿号或逗号分隔技能；没有兴趣分类时，预览只显示“技能”。</text></view>
      <view class="editor-list">
        <view class="editor-card" wx:for="{{resume.content.skills}}" wx:key="id">
          <template is="item-actions" data="{{section: 'skills', index, length: resume.content.skills.length}}" />
          <label class="editor-field"><text class="editor-label">分类</text><input class="editor-input" value="{{item.category}}" data-path="resume.content.skills[{{index}}].category" bindinput="onFieldInput" placeholder="例如：产品与数据" /></label>
          <label class="editor-field"><text class="editor-label">技能</text><textarea class="editor-textarea" value="{{item.skillsText}}" data-path="resume.content.skills[{{index}}].skillsText" bindinput="onFieldInput" placeholder="用户研究、SQL、Figma" auto-height /></label>
        </view>
        <button class="add-section-button" data-section="skills" bindtap="onAddItem">＋ 添加技能分类</button>
      </view>
    </view>

    <view class="editor-section" wx:elif="{{activeSection === 'campus'}}"><view class="section-heading"><text class="section-heading-title">校园经历</text></view><template is="text-section-list" data="{{sectionKey: 'campus', sectionLabel: '校园经历', items: resume.content.campus}}" /></view>
    <view class="editor-section" wx:elif="{{activeSection === 'awards'}}"><view class="section-heading"><text class="section-heading-title">荣誉奖项</text></view><template is="text-section-list" data="{{sectionKey: 'awards', sectionLabel: '奖项', items: resume.content.awards}}" /></view>
    <view class="editor-section" wx:elif="{{activeSection === 'certifications'}}"><view class="section-heading"><text class="section-heading-title">证书</text></view><template is="text-section-list" data="{{sectionKey: 'certifications', sectionLabel: '证书', items: resume.content.certifications}}" /></view>
    <view class="editor-section" wx:elif="{{activeSection === 'languages'}}"><view class="section-heading"><text class="section-heading-title">语言能力</text></view><template is="text-section-list" data="{{sectionKey: 'languages', sectionLabel: '语言能力', items: resume.content.languages}}" /></view>
    <view class="editor-section" wx:elif="{{activeSection === 'customSections'}}"><view class="section-heading"><text class="section-heading-title">其他内容</text></view><template is="text-section-list" data="{{sectionKey: 'customSections', sectionLabel: '自定义内容', items: resume.content.customSections, showDate: true, showRole: true}}" /></view>

    <view class="editor-bottom-save">
      <button class="primary-button" loading="{{saving}}" disabled="{{saving || !!aiTaskKind || !dirty}}" bindtap="onSave">{{dirty ? '保存到云端' : '已同步云端'}}</button>
    </view>
  </block>

  <view class="polish-backdrop" wx:if="{{polishTarget}}" bindtap="onClosePolish"></view>
  <view class="polish-sheet" wx:if="{{polishTarget}}">
    <view class="polish-header">
      <view>
        <text class="polish-kicker">AI 辅助 · 原文不会自动修改</text>
        <text class="polish-title">智能润色</text>
      </view>
      <button class="polish-close" wx:if="{{polishBusy}}" bindtap="onCancelAiTask">取消</button>
      <button class="polish-close" wx:else bindtap="onClosePolish">关闭</button>
    </view>
    <scroll-view class="polish-scroll" scroll-y>
      <view class="polish-loading" wx:if="{{polishBusy}}" aria-role="progressbar" aria-label="{{aiTaskStage}}，已用 {{aiTaskElapsedSeconds}} 秒">
        <view class="ai-task-copy">
          <view>
            <text class="polish-loading-title">{{aiTaskStage}}</text>
            <text class="polish-loading-copy">已用 {{aiTaskElapsedSeconds}} 秒，会保留原文事实与责任边界。</text>
          </view>
        </view>
        <view class="ai-task-track"><view class="ai-task-fill"></view></view>
      </view>
      <block wx:elif="{{polishResult}}">
        <text class="polish-summary">{{polishResult.summary}}</text>
        <view class="polish-column">
          <text class="polish-column-title">原文</text>
          <view class="polish-bullet" wx:for="{{polishTarget.originalBullets}}" wx:key="*this"><text>•</text><text>{{item}}</text></view>
        </view>
        <view class="polish-column polish-column-revised">
          <text class="polish-column-title">建议稿</text>
          <view class="polish-bullet" wx:for="{{polishResult.revised.bullets}}" wx:key="*this"><text>•</text><text>{{item}}</text></view>
        </view>
        <view class="polish-note" wx:if="{{polishResult.suggestions.length}}">
          <text class="polish-note-title">还可以补充</text>
          <text class="polish-note-item" wx:for="{{polishResult.suggestions}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="polish-note polish-warning" wx:if="{{polishResult.warnings.length}}">
          <text class="polish-note-title">需要留意</text>
          <text class="polish-note-item" wx:for="{{polishResult.warnings}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="verification-panel" wx:if="{{polishResult.verificationItems.length}}">
          <text class="verification-title">AI 补充的细节，采用前请核实</text>
          <view class="verification-item" wx:for="{{polishResult.verificationItems}}" wx:key="detail">
            <text class="verification-detail">{{item.detail}}</text>
            <text class="verification-reason">{{item.reason}}</text>
          </view>
          <checkbox-group bindchange="onVerificationChange">
            <label class="verification-check"><checkbox value="confirmed" checked="{{verificationConfirmed}}" color="#12294e" />我已逐项核实，以上细节真实且可以解释</label>
          </checkbox-group>
        </view>
      </block>
    </scroll-view>
    <view class="polish-actions" wx:if="{{polishResult}}">
      <button class="secondary-button" bindtap="onClosePolish">保留原文</button>
      <button class="primary-button" disabled="{{polishResult.verificationItems.length && !verificationConfirmed}}" bindtap="onApplyPolish">{{polishResult.verificationItems.length ? '核实后应用' : '应用修改'}}</button>
    </view>
  </view>
</view>
