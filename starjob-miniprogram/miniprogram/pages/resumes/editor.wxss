page {
  background: var(--color-paper);
}

.resume-editor-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(80rpx + env(safe-area-inset-bottom));
}

.editor-loading {
  padding-top: 40rpx;
}

.editor-skeleton-title {
  width: 56%;
  height: 42rpx;
}

.editor-skeleton-block {
  height: 260rpx;
  margin-top: 30rpx;
}

.editor-toolbar {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 12rpx 0;
  background: rgba(233, 235, 239, 0.96);
}

.editor-title-copy {
  min-width: 0;
  flex: 1;
}

.editor-title,
.editor-status {
  display: block;
}

.editor-title {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-status {
  margin-top: 7rpx;
  color: var(--color-success);
  font-size: 21rpx;
}

.editor-status-dirty {
  color: #8a5b19;
}

.toolbar-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.toolbar-button,
.toolbar-save {
  min-width: 82rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 13rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.toolbar-button {
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-strong);
  color: var(--color-ink);
}

.toolbar-more {
  min-width: 60rpx;
  padding: 0 12rpx;
  letter-spacing: 2rpx;
}

.toolbar-save {
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.toolbar-save[disabled] {
  background: #b2b6bd;
}

.section-scroll {
  width: calc(100% + 56rpx);
  margin-left: -28rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.section-tabs {
  display: flex;
  width: max-content;
  gap: 8rpx;
  padding: 12rpx 28rpx 18rpx;
}

.section-tab {
  min-width: 98rpx;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 31rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 62rpx;
  white-space: nowrap;
}

.section-tab-active {
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.editor-error {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid var(--color-danger);
  background: #fff2f4;
  color: #7f2333;
  font-size: 24rpx;
}

.editor-section {
  padding-top: 30rpx;
}

.section-heading {
  margin-bottom: 22rpx;
}

.section-heading-compact {
  margin-top: 34rpx;
  margin-bottom: 16rpx;
}

.section-heading-title,
.section-heading-copy {
  display: block;
}

.section-heading-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-heading-copy {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.editor-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.editor-card {
  padding: 26rpx;
  border: 1rpx solid var(--color-line-soft);
  border-radius: var(--radius-panel);
  background: var(--color-surface-strong);
}

.editor-field + .editor-field,
.field-pair + .editor-field,
.editor-field + .field-pair,
.field-pair + .field-pair,
.current-check + .editor-field {
  margin-top: 24rpx;
}

.editor-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  font-weight: 600;
}

.editor-input,
.editor-textarea {
  width: 100%;
  border: 1rpx solid var(--color-line);
  border-radius: 14rpx;
  background: #fff;
  color: var(--color-ink);
  font-size: 27rpx;
}

.editor-input {
  height: 80rpx;
  padding: 0 20rpx;
}

.editor-textarea {
  min-height: 100rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.editor-textarea-large {
  min-height: 180rpx;
}

.editor-input[disabled] {
  background: #f0f1f3;
  color: var(--color-muted);
}

.field-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.current-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: var(--color-ink-soft);
  font-size: 24rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin: -8rpx 0 22rpx;
}

.item-action {
  min-width: 74rpx;
  height: 54rpx;
  padding: 0 14rpx;
  border-radius: 11rpx;
  background: #eef0f3;
  color: var(--color-ink-soft);
  font-size: 21rpx;
  line-height: 54rpx;
}

.item-action[disabled] {
  opacity: 0.35;
}

.item-action-danger {
  background: #fff0f2;
  color: var(--color-danger);
}

.add-section-button {
  width: 100%;
  min-height: 80rpx;
  border: 1rpx dashed #9da5b0;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--color-navy);
  font-size: 26rpx;
  font-weight: 620;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.template-option {
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 14rpx;
  background: var(--color-surface-strong);
  color: var(--color-ink-soft);
  font-size: 24rpx;
  line-height: 1.35;
}

.template-option-active {
  border-color: var(--color-navy);
  background: #e8edf5;
  color: var(--color-navy);
  font-weight: 650;
}

.editor-bottom-save {
  margin-top: 38rpx;
}

.editor-error-state {
  margin-top: 100rpx;
}

@media (prefers-reduced-motion: reduce) {
  .section-tab,
  .toolbar-button,
  .toolbar-save,
  .add-section-button {
    transition: none;
  }
}
