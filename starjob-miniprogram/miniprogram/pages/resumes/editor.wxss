page {
  background: var(--color-paper);
}

.resume-editor-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(80rpx + env(safe-area-inset-bottom));
}

.editor-loading {
  padding-top: 40rpx;
}

.editor-skeleton-title {
  width: 56%;
  height: 42rpx;
}

.editor-skeleton-block {
  height: 260rpx;
  margin-top: 30rpx;
}

.editor-toolbar {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 12rpx 0;
  background: rgba(233, 235, 239, 0.96);
}

.editor-title-copy {
  min-width: 0;
  flex: 1;
}

.editor-title,
.editor-status {
  display: block;
}

.editor-title {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-status {
  margin-top: 7rpx;
  color: var(--color-success);
  font-size: 21rpx;
}

.editor-status-dirty {
  color: #8a5b19;
}

.toolbar-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.toolbar-button,
.toolbar-save {
  min-width: 82rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 13rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.toolbar-button {
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-strong);
  color: var(--color-ink);
}

.toolbar-more {
  min-width: 60rpx;
  padding: 0 12rpx;
  letter-spacing: 2rpx;
}

.toolbar-save {
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.toolbar-save[disabled] {
  background: #b2b6bd;
}

.ai-task-panel {
  margin: 8rpx 0 18rpx;
  padding: 20rpx;
  border: 1rpx solid #d9dce3;
  border-radius: 14rpx;
  background: #f7f8fb;
}

.ai-task-copy {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  text-align: left;
}

.ai-task-title,
.ai-task-helper {
  display: block;
}

.ai-task-title {
  color: var(--color-navy);
  font-size: 24rpx;
  font-weight: 660;
}

.ai-task-helper {
  color: var(--color-muted);
  font-size: 20rpx;
}

.ai-task-helper {
  margin-top: 6rpx;
}

.ai-task-track {
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e5eb;
}

.ai-task-fill {
  width: 38%;
  height: 100%;
  border-radius: inherit;
  background: var(--color-navy);
  animation: ai-task-indeterminate 1.25s ease-in-out infinite;
}

.ai-task-cancel {
  min-height: 72rpx;
  margin-top: 14rpx;
  padding: 0;
  background: transparent;
  color: var(--color-ink-soft);
  font-size: 21rpx;
  line-height: 72rpx;
}

@keyframes ai-task-indeterminate {
  from { transform: translateX(-115%); }
  to { transform: translateX(280%); }
}

.section-scroll {
  width: calc(100% + 56rpx);
  margin-left: -28rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.section-tabs {
  display: flex;
  width: max-content;
  gap: 8rpx;
  padding: 12rpx 28rpx 18rpx;
}

.section-tab {
  min-width: 98rpx;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 31rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 62rpx;
  white-space: nowrap;
}

.section-tab-active {
  background: var(--color-navy);
  color: #fff;
  font-weight: 650;
}

.editor-error {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid var(--color-danger);
  background: #fff2f4;
  color: #7f2333;
  font-size: 24rpx;
}

.editor-section {
  padding-top: 30rpx;
}

.section-heading {
  margin-bottom: 22rpx;
}

.section-heading-compact {
  margin-top: 34rpx;
  margin-bottom: 16rpx;
}

.section-heading-title,
.section-heading-copy {
  display: block;
}

.section-heading-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-heading-copy {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.editor-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.editor-card {
  padding: 26rpx;
  border: 1rpx solid var(--color-line-soft);
  border-radius: var(--radius-panel);
  background: var(--color-surface-strong);
}

.editor-field + .editor-field,
.field-pair + .editor-field,
.editor-field + .field-pair,
.field-pair + .field-pair,
.current-check + .editor-field {
  margin-top: 24rpx;
}

.editor-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  font-weight: 600;
}

.editor-input,
.editor-textarea {
  width: 100%;
  border: 1rpx solid var(--color-line);
  border-radius: 14rpx;
  background: #fff;
  color: var(--color-ink);
  font-size: 27rpx;
}

.editor-input {
  height: 80rpx;
  padding: 0 20rpx;
}

.editor-textarea {
  min-height: 100rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.editor-textarea-large {
  min-height: 180rpx;
}

.editor-input[disabled] {
  background: #f0f1f3;
  color: var(--color-muted);
}

.field-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.current-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: var(--color-ink-soft);
  font-size: 24rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin: -8rpx 0 22rpx;
}

.item-action {
  min-width: 74rpx;
  height: 54rpx;
  padding: 0 14rpx;
  border-radius: 11rpx;
  background: #eef0f3;
  color: var(--color-ink-soft);
  font-size: 21rpx;
  line-height: 54rpx;
}

.item-action[disabled] {
  opacity: 0.35;
}

.item-action-danger {
  background: #fff0f2;
  color: var(--color-danger);
}

.polish-trigger {
  width: 100%;
  min-height: 66rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(86, 74, 113, 0.2);
  border-radius: 12rpx;
  background: rgba(86, 74, 113, 0.07);
  color: #57558b;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 64rpx;
}

.section-order-list {
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
}

.section-order-row {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--color-line-soft);
}

.section-order-row:last-child {
  border-bottom: 0;
}

.section-order-index {
  width: 34rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.section-order-label {
  min-width: 0;
  flex: 1;
  color: var(--color-ink);
  font-size: 25rpx;
  font-weight: 600;
}

.section-order-actions {
  display: flex;
  gap: 8rpx;
}

.photo-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: #fff;
}

.photo-preview {
  display: grid;
  width: 116rpx;
  height: 148rpx;
  flex: 0 0 auto;
  place-items: center;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: 10rpx;
  background: #f2f3f6;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  color: var(--color-muted);
  font-size: 20rpx;
}

.photo-actions {
  min-width: 0;
  flex: 1;
}

.photo-helper {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.photo-buttons {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.photo-button {
  min-height: 58rpx;
  padding: 0 18rpx;
  line-height: 56rpx;
}

.add-section-button {
  width: 100%;
  min-height: 80rpx;
  border: 1rpx dashed #9da5b0;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--color-navy);
  font-size: 26rpx;
  font-weight: 620;
}

.polish-backdrop {
  position: fixed;
  z-index: 80;
  inset: 0;
  background: rgba(3, 7, 18, 0.48);
}

.polish-sheet {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  max-height: 88vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  border-radius: 30rpx 30rpx 0 0;
  background: #f7f7f9;
  box-shadow: 0 -20rpx 60rpx rgba(3, 7, 18, 0.16);
}

.polish-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.polish-kicker,
.polish-title {
  display: block;
}

.polish-kicker {
  color: var(--color-muted);
  font-size: 20rpx;
}

.polish-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 720;
}

.polish-close {
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #e9eaee;
  color: var(--color-ink-soft);
  font-size: 22rpx;
  line-height: 58rpx;
}

.polish-scroll {
  min-height: 0;
  flex: 1;
  margin-top: 24rpx;
}

.polish-loading {
  padding: 80rpx 20rpx;
  text-align: center;
}

.polish-loading .ai-task-copy {
  text-align: left;
}

.polish-loading-title,
.polish-loading-copy,
.polish-summary,
.polish-column-title,
.polish-note-title,
.polish-note-item,
.verification-title,
.verification-detail,
.verification-reason {
  display: block;
}

.polish-loading-title {
  font-size: 29rpx;
  font-weight: 680;
}

.polish-loading-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.polish-summary {
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #57558b;
  background: rgba(86, 74, 113, 0.07);
  color: var(--color-ink-soft);
  font-size: 23rpx;
  line-height: 1.6;
}

.polish-column {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  background: #fff;
}

.polish-column-revised {
  border-color: rgba(86, 74, 113, 0.25);
}

.polish-column-title,
.polish-note-title {
  font-size: 24rpx;
  font-weight: 680;
}

.polish-bullet {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--color-ink-soft);
  font-size: 23rpx;
  line-height: 1.65;
}

.polish-bullet > text:last-child {
  min-width: 0;
  flex: 1;
}

.polish-note,
.verification-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #fff;
}

.polish-warning,
.verification-panel {
  background: #fff7ed;
}

.polish-note-item,
.verification-reason {
  margin-top: 9rpx;
  color: var(--color-ink-soft);
  font-size: 22rpx;
  line-height: 1.6;
}

.verification-title {
  color: #8a4d17;
  font-size: 25rpx;
  font-weight: 700;
}

.verification-item {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(138, 77, 23, 0.14);
}

.verification-detail {
  color: var(--color-ink);
  font-size: 23rpx;
  font-weight: 630;
}

.verification-check {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  color: var(--color-ink-soft);
  font-size: 22rpx;
  line-height: 1.5;
}

.polish-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding-top: 20rpx;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.template-option {
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 14rpx;
  background: var(--color-surface-strong);
  color: var(--color-ink-soft);
  font-size: 24rpx;
  line-height: 1.35;
}

.template-option-active {
  border-color: var(--color-navy);
  background: #e8edf5;
  color: var(--color-navy);
  font-weight: 650;
}

.editor-bottom-save {
  margin-top: 38rpx;
}

.editor-error-state {
  margin-top: 100rpx;
}

@media (prefers-reduced-motion: reduce) {
  .section-tab,
  .toolbar-button,
  .toolbar-save,
  .add-section-button {
    transition: none;
  }

  .ai-task-fill {
    width: 100%;
    opacity: 0.5;
    animation: none;
  }
}
