<view class="page-shell resumes-page">
  <view class="page-brand-header">
    <image class="brand-wordmark" src="/assets/shi-xing-wordmark-dark.png" mode="aspectFit" />
    <text class="page-kicker">简历制作</text>
  </view>

  <view class="page-header">
    <view>
      <text class="page-title">我的简历</text>
      <text class="page-description">与网页版共用同一份云端简历。</text>
    </view>
    <view class="header-actions">
      <button class="import-trigger" bindtap="onToggleImport">{{showImportForm ? '取消导入' : '导入'}}</button>
      <button
        class="create-trigger"
        wx:if="{{resumeCreationAvailable}}"
        bindtap="onToggleCreate"
      >{{showCreateForm ? '取消' : '新建'}}</button>
    </view>
  </view>

  <view class="create-panel surface-card" wx:if="{{authenticated && showCreateForm}}">
    <text class="create-title">新建一份简历</text>
    <label class="form-group">
      <text class="form-label">简历名称</text>
      <input
        class="form-input"
        value="{{draftTitle}}"
        placeholder="例如：产品经理校招版"
        placeholder-class="form-placeholder"
        maxlength="50"
        bindinput="onDraftTitleInput"
      />
    </label>
    <label class="form-group">
      <text class="form-label">目标岗位</text>
      <input
        class="form-input"
        value="{{draftTargetRole}}"
        placeholder="例如：产品经理"
        placeholder-class="form-placeholder"
        maxlength="80"
        bindinput="onDraftTargetRoleInput"
      />
    </label>
    <view class="form-group">
      <text class="form-label">版式</text>
      <scroll-view scroll-x class="template-scroll" show-scrollbar="{{false}}">
        <view class="template-row">
          <button
            wx:for="{{templateOptions}}"
            wx:key="id"
            class="template-chip {{draftTemplateId === item.id ? 'template-chip-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onTemplateTap"
          >{{item.label}}</button>
        </view>
      </scroll-view>
    </view>
    <button class="primary-button create-submit" loading="{{creating}}" disabled="{{creating}}" bindtap="onCreateResume">创建并同步</button>
  </view>

  <view class="create-panel surface-card" wx:if="{{authenticated && showImportForm}}">
    <text class="create-title">导入已有简历</text>
    <text class="import-helper">小程序支持粘贴简历文字或读取微信聊天中的 TXT。PDF、DOCX 请在网页版导入，原文件不会被小程序上传。</text>
    <view class="import-tools">
      <button class="import-tool" bindtap="onPasteResumeText">粘贴剪贴板</button>
      <button class="import-tool" bindtap="onChooseResumeTextFile">选择 TXT</button>
    </view>
    <textarea
      class="import-textarea"
      value="{{importText}}"
      bindinput="onImportTextInput"
      placeholder="粘贴姓名、联系方式、教育、实习、项目和技能等简历文字"
      maxlength="24000"
      auto-height
    />
    <text class="import-count">{{importText.length}} / 24000</text>
    <text class="import-error" wx:if="{{importErrorMessage}}">{{importErrorMessage}}</text>
    <view class="import-actions">
      <button class="secondary-button import-submit" loading="{{importingMode === 'program'}}" disabled="{{!!importingMode}}" data-mode="program" bindtap="onImportResume">直接结构识别</button>
      <button class="primary-button import-submit" loading="{{importingMode === 'ai'}}" disabled="{{!!importingMode}}" data-mode="ai" bindtap="onImportResume">智能复核并导入</button>
    </view>
    <view class="import-progress" wx:if="{{importingMode}}" aria-role="progressbar" aria-label="{{importStage}}，已用 {{importElapsedSeconds}} 秒">
      <view class="import-progress-copy">
        <view>
          <text class="import-progress-title">{{importStage}}</text>
          <text class="import-progress-helper">已用 {{importElapsedSeconds}} 秒，请保持当前页面开启</text>
        </view>
      </view>
      <view class="import-progress-track">
        <view class="import-progress-fill"></view>
      </view>
      <button class="import-cancel" bindtap="onCancelImport">取消本次导入</button>
    </view>
  </view>

  <view class="state-panel" wx:if="{{!authenticated}}">
    <text class="state-title">登录后同步简历</text>
    <text class="state-copy">小程序不会把简历复制到第二套数据库。</text>
    <button class="primary-button state-action" bindtap="onLogin">登录拾星</button>
  </view>

  <view wx:elif="{{loading}}" class="resume-list">
    <view class="resume-skeleton" wx:for="{{[1, 2]}}" wx:key="*this">
      <view class="skeleton-line skeleton-title"></view>
      <view class="skeleton-line skeleton-meta"></view>
    </view>
  </view>

  <view class="state-panel" wx:elif="{{errorMessage}}">
    <text class="state-title">简历暂时没有加载出来</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button state-action" bindtap="onRetry">重新加载</button>
  </view>

  <view class="state-panel" wx:elif="{{resumes.length === 0}}">
    <text class="state-title">还没有云端简历</text>
    <text class="state-copy">创建后会与网页版实时共用同一份云端简历。</text>
    <button class="primary-button state-action" bindtap="onToggleCreate">创建第一份简历</button>
  </view>

  <view class="resume-list" wx:else>
    <button
      wx:for="{{resumes}}"
      wx:key="id"
      class="resume-row surface-card"
      data-id="{{item.id}}"
      bindtap="onResumeTap"
      hover-class="resume-row-pressed"
    >
      <view class="resume-mark">简历</view>
      <view class="resume-content">
        <text class="resume-title">{{item.title}}</text>
        <text class="resume-role">{{item.targetRole || '未设置求职方向'}}</text>
        <view class="resume-footer">
          <text class="resume-template">{{item.templateLabel}}</text>
          <text class="resume-updated">{{item.updatedLabel}}</text>
        </view>
      </view>
      <text class="resume-arrow">›</text>
    </button>
  </view>
</view>
