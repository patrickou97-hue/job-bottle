<view class="page-shell bottle-page">
  <view class="page-brand-header">
    <image class="brand-wordmark" src="/assets/shi-xing-wordmark-dark.png" mode="aspectFit" />
    <text class="page-kicker">机会与投递工作台</text>
  </view>

  <view class="bottle-hero">
    <view class="bottle-hero-copy">
      <text class="page-title">星瓶与投递</text>
      <text class="page-description">把机会收进来，再把每一步推进下去。</text>
      <button class="add-job-button" bindtap="onExplore">＋ 收录岗位</button>
    </view>
    <image
      class="bottle-art"
      src="/assets/star-bottle-image2.png"
      mode="aspectFit"
    />
  </view>

  <view class="bottle-stats" wx:if="{{authenticated}}">
    <view class="stat-item">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">全部星星</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{activeCount}}</text>
      <text class="stat-label">正在推进</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{offerCount}}</text>
      <text class="stat-label">Offer</text>
    </view>
  </view>

  <view class="state-panel" wx:if="{{!authenticated}}">
    <text class="state-title">登录后查看你的星瓶</text>
    <text class="state-copy">使用微信或邮箱登录，查看并推进你保存的岗位。</text>
    <button class="primary-button state-action" bindtap="onLogin">登录拾星</button>
  </view>

  <block wx:else>
    <scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="filter-row">
        <button
          wx:for="{{filters}}"
          wx:key="id"
          class="bottle-filter {{filter === item.id ? 'bottle-filter-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilterTap"
        >{{item.label}}</button>
      </view>
    </scroll-view>

    <view class="bottle-list" wx:if="{{loading}}">
      <view class="bottle-skeleton surface-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skeleton-line skeleton-company"></view>
        <view class="skeleton-line skeleton-role"></view>
        <view class="skeleton-line skeleton-meta"></view>
      </view>
    </view>

    <view class="state-panel" wx:elif="{{errorMessage}}">
      <text class="state-title">星瓶暂时没有打开</text>
      <text class="state-copy">{{errorMessage}}</text>
      <button class="secondary-button state-action" bindtap="onRetry">重新加载</button>
    </view>

    <view class="state-panel" wx:elif="{{applications.length === 0}}">
      <text class="state-title">这个分组还是空的</text>
      <text class="state-copy">在岗位详情点击“加入星瓶”，机会会立刻同步到这里。</text>
      <button class="primary-button state-action" bindtap="onExplore">去岗位坐标</button>
    </view>

    <view class="bottle-list" wx:else>
      <view wx:for="{{applications}}" wx:key="id" class="bottle-card surface-card">
        <button class="bottle-main" data-job-id="{{item.jobId}}" bindtap="onJobTap">
          <view class="bottle-card-top">
            <text class="bottle-stage">{{item.stageLabel}}</text>
            <text class="bottle-date">{{item.updatedLabel}}</text>
          </view>
          <text class="bottle-company">{{item.job.companyName}}</text>
          <text class="bottle-role">{{item.job.jobTitles}}</text>
          <text class="bottle-location">{{item.job.locations}}</text>
        </button>
        <view class="bottle-actions">
          <text class="status-pill">{{item.statusLabel}}</text>
          <button class="progress-button detail-button" data-id="{{item.id}}" bindtap="onEditDetails">编辑详情</button>
          <picker
            class="progress-picker"
            wx:if="{{progressUpdateAvailable}}"
            mode="selector"
            range="{{statusOptions}}"
            range-key="label"
            data-id="{{item.id}}"
            disabled="{{!!updatingId}}"
            bindchange="onStatusChange"
          >
            <view class="progress-button">
              {{updatingId === item.id ? '同步中…' : '更改状态'}}
            </view>
          </picker>
        </view>
      </view>
    </view>
  </block>

  <view class="workflow-backdrop" wx:if="{{editingApplication}}" bindtap="onCloseDetails"></view>
  <view class="workflow-sheet" wx:if="{{editingApplication}}">
    <view class="workflow-header">
      <view>
        <text class="workflow-title">{{editingApplication.job.companyName}}</text>
        <text class="workflow-subtitle">{{editingApplication.job.jobTitles}}</text>
      </view>
      <button class="workflow-close" bindtap="onCloseDetails">关闭</button>
    </view>
    <scroll-view class="workflow-scroll" scroll-y>
      <view class="workflow-grid">
        <label class="workflow-field">
          <text class="form-label">投递状态</text>
          <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{editingApplication.statusIndex}}" bindchange="onDetailStatusChange">
            <view class="workflow-picker">{{statusOptions[editingApplication.statusIndex].label}} ›</view>
          </picker>
        </label>
        <label class="workflow-field">
          <text class="form-label">星瓶阶段</text>
          <picker mode="selector" range="{{stageOptions}}" range-key="label" value="{{editingApplication.stageIndex}}" bindchange="onDetailStageChange">
            <view class="workflow-picker">{{stageOptions[editingApplication.stageIndex].label}} ›</view>
          </picker>
        </label>
        <label class="workflow-field">
          <text class="form-label">优先级</text>
          <picker mode="selector" range="{{priorityOptions}}" value="{{editingApplication.priorityIndex}}" bindchange="onDetailPriorityChange">
            <view class="workflow-picker">{{priorityOptions[editingApplication.priorityIndex]}} ›</view>
          </picker>
        </label>
        <label class="workflow-field"><text class="form-label">自定义阶段</text><input class="form-input" value="{{editingApplication.customStageLabel}}" data-field="customStageLabel" bindinput="onDetailInput" maxlength="40" /></label>
        <label class="workflow-field"><text class="form-label">投递渠道</text><input class="form-input" value="{{editingApplication.applicationChannel}}" data-field="applicationChannel" bindinput="onDetailInput" placeholder="官网、内推、招聘平台" maxlength="80" /></label>
        <label class="workflow-field"><text class="form-label">投递账号</text><input class="form-input" value="{{editingApplication.applicationAccount}}" data-field="applicationAccount" bindinput="onDetailInput" maxlength="160" /></label>
        <label class="workflow-field"><text class="form-label">联系人</text><input class="form-input" value="{{editingApplication.contactName}}" data-field="contactName" bindinput="onDetailInput" maxlength="120" /></label>
        <label class="workflow-field">
          <text class="form-label">关联简历</text>
          <picker mode="selector" range="{{resumeOptions}}" range-key="title" value="{{editingApplication.resumeIndex}}" bindchange="onDetailResumeChange">
            <view class="workflow-picker">{{resumeOptions[editingApplication.resumeIndex].title}} ›</view>
          </picker>
        </label>
        <view class="workflow-field">
          <text class="form-label">下一步日期</text>
          <view class="date-row">
            <picker class="date-picker" mode="date" value="{{editingApplication.nextActionDate}}" bindchange="onDetailDateChange"><view class="workflow-picker">{{editingApplication.nextActionDate || '选择日期'}} ›</view></picker>
            <button class="date-clear" wx:if="{{editingApplication.nextActionDate}}" bindtap="onClearDetailDate">清除</button>
          </view>
        </view>
        <label class="workflow-field"><text class="form-label">下一步</text><input class="form-input" value="{{editingApplication.nextAction}}" data-field="nextAction" bindinput="onDetailInput" maxlength="300" /></label>
        <label class="workflow-field"><text class="form-label">备注</text><textarea class="workflow-textarea" value="{{editingApplication.note}}" data-field="note" bindinput="onDetailInput" maxlength="1000" auto-height /></label>
        <label class="workflow-field"><text class="form-label">复盘记录</text><textarea class="workflow-textarea workflow-review" value="{{editingApplication.reviewNote}}" data-field="reviewNote" bindinput="onDetailInput" maxlength="3000" auto-height /></label>
      </view>
    </scroll-view>
    <button class="primary-button workflow-save" loading="{{savingDetails}}" disabled="{{savingDetails}}" bindtap="onSaveDetails">保存并同步</button>
  </view>
</view>
