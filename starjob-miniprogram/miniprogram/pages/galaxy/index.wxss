page {
  overflow: hidden;
  background: #030712;
}

.galaxy-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: calc(118rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(ellipse at 12% 36%, rgba(29, 58, 101, 0.34), transparent 38%),
    radial-gradient(ellipse at 88% 72%, rgba(126, 84, 42, 0.11), transparent 34%),
    linear-gradient(155deg, #02050c 0%, #07101f 48%, #0a1830 100%);
  color: #f1efff;
}

.galaxy-header {
  position: relative;
  z-index: 20;
  padding-right: 30rpx;
  padding-left: 30rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  min-height: 32px;
  transform: translateY(12rpx);
}

.galaxy-wordmark {
  width: 136rpx;
  height: 60rpx;
}

.brand-english {
  margin-left: 17rpx;
  color: rgba(201, 197, 228, 0.54);
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 5rpx;
}

.welcome-copy {
  margin-top: 52rpx;
}

.welcome-kicker,
.welcome-title,
.welcome-subtitle {
  display: block;
}

.welcome-kicker {
  color: rgba(201, 197, 228, 0.58);
  font-size: 21rpx;
  font-weight: 620;
  letter-spacing: 3rpx;
}

.welcome-title {
  margin-top: 13rpx;
  font-size: 46rpx;
  font-weight: 680;
  letter-spacing: -1.5rpx;
  line-height: 1.22;
}

.welcome-subtitle {
  margin-top: 12rpx;
  color: rgba(201, 197, 228, 0.66);
  font-size: 24rpx;
  line-height: 1.5;
}

.galaxy-scene {
  position: relative;
  z-index: 10;
  height: min(790rpx, 53vh);
  min-height: 650rpx;
  margin-top: 18rpx;
}

.orbit-line,
.core-system,
.orbit-carrier {
  position: absolute;
  left: 48%;
  top: 52%;
}

.orbit-line {
  border: 1rpx solid rgba(175, 190, 218, 0.11);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.orbit-line-inner {
  width: 290rpx;
  height: 290rpx;
}

.orbit-line-middle {
  width: 430rpx;
  height: 430rpx;
  border-color: rgba(126, 124, 181, 0.11);
}

.orbit-line-outer {
  width: 580rpx;
  height: 580rpx;
  border-color: rgba(126, 124, 181, 0.08);
}

.core-system {
  z-index: 9;
  display: flex;
  width: 130rpx;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
}

.core-glow {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: rgba(108, 137, 184, 0.18);
  filter: blur(38rpx);
  transform: translate(-50%, -50%);
}

.core-planet,
.planet-orb {
  position: relative;
  overflow: hidden;
  border-radius: 50%;
}

.core-planet {
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid rgba(177, 195, 221, 0.18);
  background:
    radial-gradient(ellipse at 64% 30%, rgba(129, 154, 187, 0.2) 0 14%, transparent 15%),
    radial-gradient(ellipse at 30% 66%, rgba(10, 28, 49, 0.5) 0 22%, transparent 23%),
    linear-gradient(145deg, #58728f 0%, #2a4767 42%, #132a43 68%, #050b13 100%);
  box-shadow:
    0 0 38rpx rgba(67, 101, 146, 0.16),
    inset -15rpx -18rpx 30rpx rgba(0, 0, 0, 0.4);
}

.core-label {
  margin-top: 12rpx;
  color: rgba(241, 239, 255, 0.88);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 5rpx;
}

.planet-glint {
  position: absolute;
  left: 21%;
  top: 18%;
  width: 18rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(220, 231, 245, 0.12);
  filter: blur(6rpx);
  transform: rotate(-24deg);
}

.planet-texture,
.planet-terminator {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  pointer-events: none;
}

.planet-texture {
  opacity: 0.58;
  background:
    radial-gradient(ellipse at 70% 31%, rgba(209, 220, 235, 0.09) 0 7%, transparent 8%),
    radial-gradient(ellipse at 35% 63%, rgba(0, 0, 0, 0.24) 0 13%, transparent 14%),
    repeating-linear-gradient(168deg, transparent 0 8rpx, rgba(255, 255, 255, 0.02) 9rpx 11rpx);
}

.planet-terminator {
  background: linear-gradient(118deg, transparent 18%, rgba(1, 4, 10, 0.08) 47%, rgba(0, 2, 7, 0.7) 100%);
}

.planet-ring {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 50%;
  width: 92rpx;
  height: 25rpx;
  border: 2rpx solid rgba(211, 174, 103, 0.42);
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-17deg);
  box-shadow: 0 0 12rpx rgba(201, 151, 60, 0.12);
}

.orbit-carrier {
  z-index: 12;
  width: 0;
  height: 0;
}

.planet-hit {
  position: absolute;
  display: flex;
  width: 148rpx;
  min-height: 128rpx;
  padding: 10rpx 8rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: 28rpx;
  background: transparent;
  color: #f1efff;
  line-height: 1;
}

.planet-hit-active .planet-orb {
  transform: scale(1.05);
}

.planet-orb {
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(211, 220, 237, 0.16);
  transition: transform 180ms ease;
}

.planet-orb-jobs {
  width: 66rpx;
  height: 66rpx;
  background:
    radial-gradient(ellipse at 64% 33%, rgba(149, 174, 207, 0.14) 0 15%, transparent 16%),
    radial-gradient(ellipse at 30% 70%, rgba(6, 21, 38, 0.46) 0 20%, transparent 21%),
    linear-gradient(142deg, #58769a 0%, #2e5074 40%, #172f4b 68%, #060b13 100%);
  box-shadow: 0 0 26rpx rgba(76, 109, 151, 0.15), inset -11rpx -14rpx 22rpx rgba(0, 0, 0, 0.4);
}

.planet-orb-bottle {
  background:
    radial-gradient(ellipse at 67% 30%, rgba(221, 177, 100, 0.14) 0 15%, transparent 16%),
    linear-gradient(148deg, #9a6f35 0%, #684722 43%, #352516 71%, #090604 100%);
  box-shadow: 0 0 24rpx rgba(156, 108, 47, 0.16), inset -11rpx -14rpx 22rpx rgba(0, 0, 0, 0.45);
}

.planet-orb-resume {
  background:
    radial-gradient(ellipse at 65% 31%, rgba(190, 153, 171, 0.12) 0 15%, transparent 16%),
    linear-gradient(145deg, #755262 0%, #4f3546 43%, #2b2031 71%, #08050a 100%);
  box-shadow: 0 0 22rpx rgba(116, 76, 97, 0.14), inset -11rpx -14rpx 22rpx rgba(0, 0, 0, 0.45);
}

.planet-orb-profile {
  background:
    radial-gradient(ellipse at 66% 31%, rgba(174, 193, 214, 0.12) 0 15%, transparent 16%),
    linear-gradient(145deg, #61758c 0%, #3a5067 43%, #1b3046 71%, #050a10 100%);
  box-shadow: 0 0 22rpx rgba(89, 116, 148, 0.14), inset -11rpx -14rpx 22rpx rgba(0, 0, 0, 0.45);
}

.planet-label {
  display: block;
  white-space: nowrap;
}

.planet-label {
  margin-top: 10rpx;
  color: rgba(241, 239, 255, 0.92);
  font-size: 20rpx;
  font-weight: 620;
  line-height: 1.3;
}

.orbit-jobs {
  animation: orbit-jobs 84s linear infinite;
}

.planet-hit-jobs {
  animation: counter-jobs 84s linear infinite;
}

.orbit-bottle {
  animation: orbit-bottle 84s linear infinite;
}

.planet-hit-bottle {
  animation: counter-bottle 84s linear infinite;
}

.orbit-resume {
  animation: orbit-resume 84s linear infinite;
}

.planet-hit-resume {
  animation: counter-resume 84s linear infinite;
}

.orbit-profile {
  animation: orbit-profile 84s linear infinite;
}

.planet-hit-profile {
  animation: counter-profile 84s linear infinite;
}

.scene-paused .orbit-carrier,
.scene-paused .planet-hit {
  animation-play-state: paused;
}

.space-haze {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
  pointer-events: none;
}

.space-haze-left {
  left: -160rpx;
  top: 36%;
  width: 360rpx;
  height: 360rpx;
  background: rgba(18, 41, 78, 0.22);
}

.space-haze-right {
  right: -190rpx;
  bottom: 10%;
  width: 420rpx;
  height: 420rpx;
  background: rgba(86, 74, 113, 0.12);
}

.starfield {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.starfield-far {
  opacity: 0.32;
  background:
    radial-gradient(circle at 8% 13%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 28% 36%, #9eb6d5 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 47% 18%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 64% 42%, #b7c9e1 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 82% 16%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 94% 55%, #9eb6d5 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 21% 76%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 73% 86%, #b7c9e1 0 1rpx, transparent 2rpx);
}

.starfield-near {
  opacity: 0.48;
  background:
    radial-gradient(circle at 16% 45%, #f1f5fb 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 57% 68%, #d9e5f7 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 89% 32%, #f1f5fb 0 2rpx, transparent 3rpx);
  animation: star-breathe 7s ease-in-out infinite alternate;
}

.star {
  position: absolute;
  z-index: 2;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: rgba(231, 226, 255, 0.58);
  box-shadow: 0 0 9rpx rgba(231, 226, 255, 0.36);
}

.star-1 { left: 11%; top: 22%; }
.star-2 { left: 78%; top: 26%; opacity: 0.54; }
.star-3 { left: 91%; top: 45%; }
.star-4 { left: 17%; top: 62%; opacity: 0.48; }
.star-5 { left: 67%; top: 72%; }
.star-6 { left: 38%; top: 81%; opacity: 0.5; }
.star-7 { left: 7%; top: 88%; }
.star-8 { left: 85%; top: 87%; opacity: 0.46; }

@keyframes orbit-jobs {
  from { transform: rotate(-16deg) translateX(145rpx); }
  to { transform: rotate(344deg) translateX(145rpx); }
}

@keyframes counter-jobs {
  from { transform: translate(-50%, -50%) rotate(16deg); }
  to { transform: translate(-50%, -50%) rotate(-344deg); }
}

@keyframes orbit-bottle {
  from { transform: rotate(102deg) translateX(215rpx); }
  to { transform: rotate(462deg) translateX(215rpx); }
}

@keyframes counter-bottle {
  from { transform: translate(-50%, -50%) rotate(-102deg); }
  to { transform: translate(-50%, -50%) rotate(-462deg); }
}

@keyframes orbit-resume {
  from { transform: rotate(54deg) translateX(290rpx); }
  to { transform: rotate(414deg) translateX(290rpx); }
}

@keyframes counter-resume {
  from { transform: translate(-50%, -50%) rotate(-54deg); }
  to { transform: translate(-50%, -50%) rotate(-414deg); }
}

@keyframes orbit-profile {
  from { transform: rotate(286deg) translateX(290rpx); }
  to { transform: rotate(646deg) translateX(290rpx); }
}

@keyframes counter-profile {
  from { transform: translate(-50%, -50%) rotate(-286deg); }
  to { transform: translate(-50%, -50%) rotate(-646deg); }
}

@keyframes star-breathe {
  from { opacity: 0.26; transform: scale(1); }
  to { opacity: 0.54; transform: scale(1.012); }
}

@media (prefers-reduced-motion: reduce) {
  .orbit-carrier,
  .planet-hit {
    animation: none;
  }

  .orbit-jobs { transform: rotate(-16deg) translateX(145rpx); }
  .planet-hit-jobs { transform: translate(-50%, -50%) rotate(16deg); }
  .orbit-bottle { transform: rotate(102deg) translateX(215rpx); }
  .planet-hit-bottle { transform: translate(-50%, -50%) rotate(-102deg); }
  .orbit-resume { transform: rotate(54deg) translateX(290rpx); }
  .planet-hit-resume { transform: translate(-50%, -50%) rotate(-54deg); }
  .orbit-profile { transform: rotate(286deg) translateX(290rpx); }
  .planet-hit-profile { transform: translate(-50%, -50%) rotate(-286deg); }

  .starfield-near {
    animation: none;
  }
}
