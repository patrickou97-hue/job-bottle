page {
  overflow: hidden;
  background: #000001;
}

.galaxy-page {
  position: relative;
  height: 100vh;
  min-height: 1080rpx;
  overflow: hidden;
  padding-bottom: calc(118rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(ellipse at 14% 42%, rgba(18, 41, 78, 0.26), transparent 35%),
    radial-gradient(ellipse at 88% 72%, rgba(86, 74, 113, 0.14), transparent 32%),
    #000001;
  color: #f1efff;
}

.galaxy-header {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  padding-left: 34rpx;
}

.brand-row {
  display: flex;
  min-height: 32px;
  align-items: center;
}

.galaxy-wordmark {
  width: 144rpx;
  height: 64rpx;
  filter: drop-shadow(0 0 18rpx rgba(126, 124, 181, 0.24));
}

.galaxy-scene {
  position: absolute;
  z-index: 10;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
}

.orbit-line,
.core-system,
.orbit-carrier {
  position: absolute;
  left: 50%;
  top: 51%;
}

.orbit-line {
  border: 1rpx solid rgba(126, 124, 181, 0.1);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.orbit-line-inner {
  width: 390rpx;
  height: 390rpx;
}

.orbit-line-outer {
  width: 610rpx;
  height: 610rpx;
  border-color: rgba(126, 124, 181, 0.075);
}

.core-system {
  z-index: 20;
  display: flex;
  width: 176rpx;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
}

.orb-material {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.core-planet {
  width: 104rpx;
  height: 104rpx;
  background: radial-gradient(circle at 28% 24%, rgba(231, 226, 255, 0.84) 0 4%, rgba(126, 124, 181, 0.72) 30%, rgba(18, 41, 78, 0.94) 74%);
  box-shadow:
    0 0 34rpx rgba(126, 124, 181, 0.24),
    inset -12rpx -16rpx 28rpx rgba(0, 0, 0, 0.56),
    inset 8rpx 7rpx 18rpx rgba(231, 226, 255, 0.08);
}

.core-wordmark {
  width: 132rpx;
  height: 58rpx;
  margin-top: 10rpx;
  filter: drop-shadow(0 0 20rpx rgba(126, 124, 181, 0.24));
}

.orb-shadow,
.orb-rim {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  pointer-events: none;
}

.orb-shadow {
  background: radial-gradient(circle at 76% 78%, rgba(0, 0, 1, 0.55) 0 38%, transparent 64%);
}

.orb-rim {
  inset: 1rpx;
  border: 1rpx solid rgba(231, 226, 255, 0.18);
}

.orb-highlight {
  position: absolute;
  left: 27%;
  top: 22%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(231, 226, 255, 0.78);
  box-shadow: 0 0 8rpx rgba(231, 226, 255, 0.36);
}

.orbit-carrier {
  z-index: 12;
  width: 0;
  height: 0;
}

.planet-hit {
  position: absolute;
  display: flex;
  width: 148rpx;
  min-height: 132rpx;
  padding: 8rpx 6rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: 50%;
  background: transparent;
  color: #f1efff;
  line-height: 1;
}

.planet-orb {
  width: 88rpx;
  height: 88rpx;
  transition: opacity 180ms ease, transform 180ms ease;
}

.planet-hit-active .planet-orb {
  opacity: 0.96;
  transform: scale(1.04);
}

.planet-orb-jobs {
  width: 92rpx;
  height: 92rpx;
  background: radial-gradient(circle at 28% 24%, rgba(231, 226, 255, 0.84) 0 4%, rgba(126, 124, 181, 0.72) 30%, rgba(18, 41, 78, 0.94) 74%);
  box-shadow: 0 0 18rpx rgba(126, 124, 181, 0.24), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-orb-applications {
  width: 92rpx;
  height: 92rpx;
  background: radial-gradient(circle at 28% 24%, rgba(231, 226, 255, 0.76) 0 4%, rgba(86, 74, 113, 0.76) 30%, rgba(18, 41, 78, 0.94) 74%);
  box-shadow: 0 0 18rpx rgba(86, 74, 113, 0.24), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-orb-bottle {
  width: 92rpx;
  height: 92rpx;
  background: radial-gradient(circle at 28% 24%, rgba(255, 244, 198, 0.96) 0 4%, rgba(201, 151, 60, 0.9) 30%, rgba(91, 58, 22, 0.96) 74%);
  box-shadow: 0 0 18rpx rgba(201, 151, 60, 0.38), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-orb-resume {
  width: 84rpx;
  height: 84rpx;
  background: radial-gradient(circle at 28% 24%, rgba(241, 239, 255, 0.9) 0 4%, rgba(201, 197, 228, 0.62) 30%, rgba(18, 41, 78, 0.94) 74%);
  box-shadow: 0 0 18rpx rgba(201, 197, 228, 0.2), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-orb-forum {
  width: 78rpx;
  height: 78rpx;
  background: radial-gradient(circle at 28% 24%, rgba(242, 222, 233, 0.78) 0 4%, rgba(127, 85, 104, 0.7) 30%, rgba(86, 74, 113, 0.94) 74%);
  box-shadow: 0 0 18rpx rgba(127, 85, 104, 0.22), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-orb-profile {
  width: 80rpx;
  height: 80rpx;
  background: radial-gradient(circle at 28% 24%, rgba(241, 239, 255, 0.9) 0 4%, rgba(201, 197, 228, 0.62) 30%, rgba(18, 41, 78, 0.94) 74%);
  box-shadow: 0 0 18rpx rgba(201, 197, 228, 0.2), inset -10rpx -14rpx 24rpx rgba(0, 0, 0, 0.58);
}

.planet-label {
  display: block;
  margin-top: 12rpx;
  color: rgba(201, 197, 228, 0.78);
  font-size: 22rpx;
  font-weight: 560;
  line-height: 1.25;
  text-shadow: 0 0 18rpx rgba(126, 124, 181, 0.12);
  white-space: nowrap;
}

.planet-icon {
  position: relative;
  z-index: 4;
  width: 34rpx;
  height: 34rpx;
  color: rgba(241, 239, 255, 0.82);
}

.briefcase-body {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 11rpx;
  bottom: 4rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}

.briefcase-handle {
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}

.icon-document,
.icon-resume {
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.document-line,
.resume-line {
  position: absolute;
  left: 7rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.document-line-a,
.resume-line-a {
  right: 7rpx;
  top: 11rpx;
}

.document-line-b,
.resume-line-b {
  right: 12rpx;
  top: 20rpx;
}

.resume-spine {
  position: absolute;
  left: 5rpx;
  top: 4rpx;
  bottom: 4rpx;
  width: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  opacity: 0.58;
}

.spark-line {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 4rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.spark-line-vertical {
  width: 3rpx;
  height: 30rpx;
}

.spark-line-horizontal {
  width: 30rpx;
  height: 3rpx;
}

.profile-head {
  position: absolute;
  left: 50%;
  top: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}

.profile-shoulders {
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 27rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateX(-50%);
}

.guide-page {
  position: absolute;
  top: 7rpx;
  bottom: 5rpx;
  width: 14rpx;
  border: 2rpx solid currentColor;
}

.guide-page-left {
  left: 3rpx;
  border-radius: 4rpx 1rpx 1rpx 4rpx;
  transform: skewY(7deg);
}

.guide-page-right {
  right: 3rpx;
  border-radius: 1rpx 4rpx 4rpx 1rpx;
  transform: skewY(-7deg);
}

.guide-spine {
  position: absolute;
  left: 50%;
  top: 6rpx;
  bottom: 4rpx;
  width: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.orbit-jobs,
.planet-hit-jobs,
.orbit-applications,
.planet-hit-applications,
.orbit-bottle,
.planet-hit-bottle,
.orbit-resume,
.planet-hit-resume,
.orbit-forum,
.planet-hit-forum,
.orbit-profile,
.planet-hit-profile {
  animation-duration: 138s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.orbit-jobs { animation-name: orbit-jobs; }
.planet-hit-jobs { animation-name: counter-jobs; }
.orbit-applications { animation-name: orbit-applications; }
.planet-hit-applications { animation-name: counter-applications; }
.orbit-bottle { animation-name: orbit-bottle; }
.planet-hit-bottle { animation-name: counter-bottle; }
.orbit-resume { animation-name: orbit-resume; }
.planet-hit-resume { animation-name: counter-resume; }
.orbit-forum { animation-name: orbit-forum; }
.planet-hit-forum { animation-name: counter-forum; }
.orbit-profile { animation-name: orbit-profile; }
.planet-hit-profile { animation-name: counter-profile; }

.scene-paused .orbit-carrier,
.scene-paused .planet-hit {
  animation-play-state: paused;
}

.space-wash {
  position: absolute;
  border-radius: 50%;
  filter: blur(70rpx);
  pointer-events: none;
}

.space-wash-blue {
  left: -190rpx;
  top: 34%;
  width: 390rpx;
  height: 390rpx;
  background: rgba(18, 41, 78, 0.2);
}

.space-wash-violet {
  right: -210rpx;
  bottom: 8%;
  width: 430rpx;
  height: 430rpx;
  background: rgba(86, 74, 113, 0.11);
}

.starfield {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.starfield-far {
  opacity: 0.3;
  background:
    radial-gradient(circle at 8% 13%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 28% 36%, #9eb6d5 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 47% 18%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 64% 42%, #b7c9e1 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 82% 16%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 94% 55%, #9eb6d5 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 21% 76%, #d9e5f7 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 73% 86%, #b7c9e1 0 1rpx, transparent 2rpx);
}

.starfield-near {
  opacity: 0.44;
  background:
    radial-gradient(circle at 16% 45%, #f1f5fb 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 57% 68%, #d9e5f7 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 89% 32%, #f1f5fb 0 2rpx, transparent 3rpx);
  animation: star-breathe 7s ease-in-out infinite alternate;
}

@keyframes orbit-jobs {
  from { transform: rotate(12deg) translateX(305rpx); }
  to { transform: rotate(372deg) translateX(305rpx); }
}

@keyframes counter-jobs {
  from { transform: translate(-50%, -50%) rotate(-12deg); }
  to { transform: translate(-50%, -50%) rotate(-372deg); }
}

@keyframes orbit-applications {
  from { transform: rotate(104deg) translateX(305rpx); }
  to { transform: rotate(464deg) translateX(305rpx); }
}

@keyframes counter-applications {
  from { transform: translate(-50%, -50%) rotate(-104deg); }
  to { transform: translate(-50%, -50%) rotate(-464deg); }
}

@keyframes orbit-bottle {
  from { transform: rotate(198deg) translateX(305rpx); }
  to { transform: rotate(558deg) translateX(305rpx); }
}

@keyframes counter-bottle {
  from { transform: translate(-50%, -50%) rotate(-198deg); }
  to { transform: translate(-50%, -50%) rotate(-558deg); }
}

@keyframes orbit-resume {
  from { transform: rotate(302deg) translateX(195rpx); }
  to { transform: rotate(662deg) translateX(195rpx); }
}

@keyframes counter-resume {
  from { transform: translate(-50%, -50%) rotate(-302deg); }
  to { transform: translate(-50%, -50%) rotate(-662deg); }
}

@keyframes orbit-forum {
  from { transform: rotate(48deg) translateX(195rpx); }
  to { transform: rotate(408deg) translateX(195rpx); }
}

@keyframes counter-forum {
  from { transform: translate(-50%, -50%) rotate(-48deg); }
  to { transform: translate(-50%, -50%) rotate(-408deg); }
}

@keyframes orbit-profile {
  from { transform: rotate(168deg) translateX(195rpx); }
  to { transform: rotate(528deg) translateX(195rpx); }
}

@keyframes counter-profile {
  from { transform: translate(-50%, -50%) rotate(-168deg); }
  to { transform: translate(-50%, -50%) rotate(-528deg); }
}

@keyframes star-breathe {
  from { opacity: 0.24; transform: scale(1); }
  to { opacity: 0.5; transform: scale(1.01); }
}

@media (max-height: 700px) {
  .orbit-line-inner {
    width: 360rpx;
    height: 360rpx;
  }

  .orbit-line-outer {
    width: 560rpx;
    height: 560rpx;
  }

  @keyframes orbit-jobs {
    from { transform: rotate(12deg) translateX(280rpx); }
    to { transform: rotate(372deg) translateX(280rpx); }
  }

  @keyframes orbit-applications {
    from { transform: rotate(104deg) translateX(280rpx); }
    to { transform: rotate(464deg) translateX(280rpx); }
  }

  @keyframes orbit-bottle {
    from { transform: rotate(198deg) translateX(280rpx); }
    to { transform: rotate(558deg) translateX(280rpx); }
  }

  @keyframes orbit-resume {
    from { transform: rotate(302deg) translateX(180rpx); }
    to { transform: rotate(662deg) translateX(180rpx); }
  }

  @keyframes orbit-forum {
    from { transform: rotate(48deg) translateX(180rpx); }
    to { transform: rotate(408deg) translateX(180rpx); }
  }

  @keyframes orbit-profile {
    from { transform: rotate(168deg) translateX(180rpx); }
    to { transform: rotate(528deg) translateX(180rpx); }
  }
}

@media (prefers-reduced-motion: reduce) {
  .orbit-carrier,
  .planet-hit,
  .starfield-near {
    animation: none;
  }

  .orbit-jobs { transform: rotate(12deg) translateX(305rpx); }
  .planet-hit-jobs { transform: translate(-50%, -50%) rotate(-12deg); }
  .orbit-applications { transform: rotate(104deg) translateX(305rpx); }
  .planet-hit-applications { transform: translate(-50%, -50%) rotate(-104deg); }
  .orbit-bottle { transform: rotate(198deg) translateX(305rpx); }
  .planet-hit-bottle { transform: translate(-50%, -50%) rotate(-198deg); }
  .orbit-resume { transform: rotate(302deg) translateX(195rpx); }
  .planet-hit-resume { transform: translate(-50%, -50%) rotate(-302deg); }
  .orbit-forum { transform: rotate(48deg) translateX(195rpx); }
  .planet-hit-forum { transform: translate(-50%, -50%) rotate(-48deg); }
  .orbit-profile { transform: rotate(168deg) translateX(195rpx); }
  .planet-hit-profile { transform: translate(-50%, -50%) rotate(-168deg); }
}
