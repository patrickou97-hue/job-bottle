<view class="galaxy-page {{sceneActive ? '' : 'scene-paused'}}">
  <view class="space-wash space-wash-blue"></view>
  <view class="space-wash space-wash-violet"></view>
  <view class="starfield starfield-far"></view>
  <view class="starfield starfield-near"></view>

  <view class="galaxy-header" style="padding-top: {{menuTop}}px;">
    <view class="brand-row" style="height: {{menuHeight}}px; max-width: {{menuLeft - 28}}px;">
      <image class="galaxy-wordmark" src="/assets/shi-xing-wordmark.png" mode="aspectFit" />
    </view>
  </view>

  <view class="galaxy-scene">
    <view class="orbit-line orbit-line-inner"></view>
    <view class="orbit-line orbit-line-outer"></view>

    <view class="core-system">
      <view class="core-planet orb-material">
        <view class="orb-shadow"></view>
        <view class="orb-rim"></view>
        <view class="orb-highlight"></view>
      </view>
      <image class="core-wordmark" src="/assets/shi-xing-wordmark.png" mode="aspectFit" />
    </view>

    <view class="orbit-carrier orbit-jobs">
      <button
        class="planet-hit planet-hit-jobs {{activePlanet === 'jobs' ? 'planet-hit-active' : ''}}"
        data-id="jobs"
        data-route="/pages/jobs/index"
        data-tab="{{true}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入岗位"
      >
        <view class="planet-orb planet-orb-jobs orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-briefcase">
            <view class="briefcase-handle"></view>
            <view class="briefcase-body"></view>
          </view>
        </view>
        <text class="planet-label">岗位</text>
      </button>
    </view>

    <view class="orbit-carrier orbit-applications">
      <button
        class="planet-hit planet-hit-applications {{activePlanet === 'applications' ? 'planet-hit-active' : ''}}"
        data-id="applications"
        data-route="/pages/applications/index"
        data-tab="{{false}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入投递记录"
      >
        <view class="planet-orb planet-orb-applications orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-document">
            <view class="document-line document-line-a"></view>
            <view class="document-line document-line-b"></view>
          </view>
        </view>
        <text class="planet-label">投递</text>
      </button>
    </view>

    <view class="orbit-carrier orbit-bottle">
      <button
        class="planet-hit planet-hit-bottle {{activePlanet === 'bottle' ? 'planet-hit-active' : ''}}"
        data-id="bottle"
        data-route="/pages/bottle/index"
        data-tab="{{true}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入星瓶"
      >
        <view class="planet-orb planet-orb-bottle orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-spark">
            <view class="spark-line spark-line-vertical"></view>
            <view class="spark-line spark-line-horizontal"></view>
          </view>
        </view>
        <text class="planet-label">星瓶</text>
      </button>
    </view>

    <view class="orbit-carrier orbit-resume">
      <button
        class="planet-hit planet-hit-resume {{activePlanet === 'resume' ? 'planet-hit-active' : ''}}"
        data-id="resume"
        data-route="/pages/resumes/index"
        data-tab="{{true}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入简历"
      >
        <view class="planet-orb planet-orb-resume orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-resume">
            <view class="resume-spine"></view>
            <view class="resume-line resume-line-a"></view>
            <view class="resume-line resume-line-b"></view>
          </view>
        </view>
        <text class="planet-label">简历</text>
      </button>
    </view>

    <view class="orbit-carrier orbit-forum">
      <button
        class="planet-hit planet-hit-forum {{activePlanet === 'forum' ? 'planet-hit-active' : ''}}"
        data-id="forum"
        data-route="/pages/support/index"
        data-tab="{{false}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入拾星指南"
      >
        <view class="planet-orb planet-orb-forum orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-guide">
            <view class="guide-page guide-page-left"></view>
            <view class="guide-page guide-page-right"></view>
            <view class="guide-spine"></view>
          </view>
        </view>
        <text class="planet-label">指南</text>
      </button>
    </view>

    <view class="orbit-carrier orbit-profile">
      <button
        class="planet-hit planet-hit-profile {{activePlanet === 'profile' ? 'planet-hit-active' : ''}}"
        data-id="profile"
        data-route="/pages/profile/index"
        data-tab="{{true}}"
        bindtouchstart="onPlanetPress"
        bindtouchend="onPlanetRelease"
        bindtouchcancel="onPlanetRelease"
        bindtap="onPlanetTap"
        hover-class="none"
        aria-label="进入我的"
      >
        <view class="planet-orb planet-orb-profile orb-material">
          <view class="orb-shadow"></view>
          <view class="orb-rim"></view>
          <view class="orb-highlight"></view>
          <view class="planet-icon icon-profile">
            <view class="profile-head"></view>
            <view class="profile-shoulders"></view>
          </view>
        </view>
        <text class="planet-label">我的</text>
      </button>
    </view>
  </view>
</view>
