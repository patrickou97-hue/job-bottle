<view class="page-shell profile-page">
  <view class="page-brand-header">
    <image class="brand-wordmark" src="/assets/shi-xing-wordmark-dark.png" mode="aspectFit" />
    <text class="page-kicker">个人中心</text>
  </view>

  <view class="profile-heading">
    <text class="page-title">我的拾星</text>
    <text class="page-description">资料、偏好与账号安全</text>
  </view>

  <view class="state-panel" wx:if="{{!authenticated}}">
    <text class="state-title">登录后同步个人资料</text>
    <text class="state-copy">不会根据微信昵称自动合并网站账号。</text>
    <button class="primary-button state-action" bindtap="onLogin">登录拾星</button>
  </view>

  <view class="profile-loading" wx:elif="{{loading}}">
    <view class="skeleton-line skeleton-name"></view>
    <view class="skeleton-line skeleton-detail"></view>
    <view class="skeleton-line skeleton-detail"></view>
  </view>

  <view class="state-panel" wx:elif="{{errorMessage}}">
    <text class="state-title">个人资料暂时没有加载出来</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button state-action" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:elif="{{profile}}">
    <view class="profile-identity surface-card">
      <view class="avatar-letter">{{avatarLetter}}</view>
      <view class="identity-copy">
        <text class="profile-name">{{profile.displayName || '拾星用户'}}</text>
        <text class="profile-summary">{{profile.identitySummary}}</text>
      </view>
      <button class="profile-edit-button" bindtap="onToggleEdit">
        {{editing ? '取消' : '编辑资料'}}
      </button>
    </view>

    <view class="profile-edit-panel surface-card" wx:if="{{editing}}">
      <view class="profile-form-grid">
        <label class="form-group">
          <text class="form-label">称呼</text>
          <input class="form-input" value="{{draftDisplayName}}" data-field="draftDisplayName" bindinput="onDraftInput" maxlength="50" />
        </label>
        <label class="form-group">
          <text class="form-label">手机号</text>
          <input class="form-input" value="{{draftPhone}}" data-field="draftPhone" bindinput="onDraftInput" type="text" maxlength="30" />
        </label>
        <label class="form-group">
          <text class="form-label">所在城市</text>
          <input class="form-input" value="{{draftCity}}" data-field="draftCity" bindinput="onDraftInput" maxlength="50" />
        </label>
        <label class="form-group">
          <text class="form-label">学校</text>
          <input class="form-input" value="{{draftSchool}}" data-field="draftSchool" bindinput="onDraftInput" maxlength="100" />
        </label>
        <label class="form-group">
          <text class="form-label">专业</text>
          <input class="form-input" value="{{draftMajor}}" data-field="draftMajor" bindinput="onDraftInput" maxlength="100" />
        </label>
        <label class="form-group">
          <text class="form-label">毕业年份</text>
          <input class="form-input" value="{{draftGraduationYear}}" data-field="draftGraduationYear" bindinput="onDraftInput" maxlength="20" />
        </label>
        <label class="form-group form-group-wide">
          <text class="form-label">意向地区</text>
          <input class="form-input" value="{{draftPreferredRegions}}" data-field="draftPreferredRegions" bindinput="onDraftInput" placeholder="北京、上海、深圳" />
          <text class="form-helper">可用顿号或逗号分隔</text>
        </label>
        <label class="form-group form-group-wide">
          <text class="form-label">目标方向</text>
          <input class="form-input" value="{{draftTargetRoles}}" data-field="draftTargetRoles" bindinput="onDraftInput" placeholder="产品经理、行业研究" />
          <text class="form-helper">可用顿号或逗号分隔</text>
        </label>
      </view>
      <button class="primary-button profile-save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveProfile">保存并同步</button>
    </view>

    <view class="profile-section" wx:else>
      <text class="section-title">求职偏好</text>
      <view class="preference-row">
        <text class="preference-label">城市</text>
        <text class="preference-value">{{profile.city || '未设置'}}</text>
      </view>
      <view class="preference-row">
        <text class="preference-label">专业</text>
        <text class="preference-value">{{profile.major || '未设置'}}</text>
      </view>
      <view class="preference-row">
        <text class="preference-label">地区</text>
        <text class="preference-value">{{profile.preferredRegionsLabel}}</text>
      </view>
      <view class="preference-row">
        <text class="preference-label">方向</text>
        <text class="preference-value">{{profile.targetRolesLabel}}</text>
      </view>
    </view>

    <view class="profile-section">
      <text class="section-title">账号与支持</text>
      <view class="account-summary" wx:if="{{accountStatus}}">
        <text class="account-summary-title">登录方式</text>
        <text class="account-summary-value">{{accountStatus.hasEmail ? accountStatus.email : '未绑定邮箱'}} · {{accountStatus.hasWechat ? '微信已绑定' : '微信未绑定'}}</text>
      </view>
      <button class="menu-row" wx:if="{{accountStatus && !accountStatus.hasWechat}}" loading="{{accountLoading}}" disabled="{{accountLoading}}" bindtap="onBindWechat">
        <view class="menu-copy"><text>绑定当前微信</text><text class="menu-note">以后可使用微信进入同一账号</text></view>
        <text class="menu-arrow">›</text>
      </button>
      <button class="menu-row" wx:if="{{accountStatus && !accountStatus.hasEmail}}" bindtap="onToggleEmailBinding">
        <view class="menu-copy"><text>绑定已有邮箱账号</text><text class="menu-note">验证密码后合并投递和简历数据</text></view>
        <text class="menu-arrow">›</text>
      </button>
      <view class="email-binding-panel" wx:if="{{showEmailBinding}}">
        <label class="form-group"><text class="form-label">邮箱</text><input class="form-input" value="{{bindingEmail}}" bindinput="onBindingEmailInput" /></label>
        <label class="form-group"><text class="form-label">密码</text><input class="form-input" value="{{bindingPassword}}" password bindinput="onBindingPasswordInput" /></label>
        <button class="primary-button binding-submit" loading="{{accountLoading}}" disabled="{{accountLoading}}" bindtap="onBindEmail">验证并合并账号</button>
      </view>
      <button class="menu-row danger-row" wx:if="{{accountStatus && accountStatus.hasWechat && accountStatus.hasEmail}}" loading="{{accountLoading}}" disabled="{{accountLoading}}" bindtap="onUnbindWechat">
        <text>解绑微信</text>
      </button>
      <button class="menu-row" bindtap="onOpenSupport">
        <view class="menu-copy">
          <text>拾星指南与反馈</text>
          <text class="menu-note">公告、教程、经验与问题反馈</text>
        </view>
        <text class="menu-arrow">›</text>
      </button>
      <button
        class="menu-row"
        wx:if="{{webLoginCodeAvailable}}"
        loading="{{generatingWebCode}}"
        disabled="{{generatingWebCode}}"
        bindtap="onGenerateWebCode"
      >
        <view class="menu-copy">
          <text>登录网页版</text>
          <text class="menu-note">生成 8 位一次性登录码</text>
        </view>
        <text class="menu-arrow">›</text>
      </button>
      <button
        class="menu-row danger-row"
        loading="{{loggingOut}}"
        disabled="{{loggingOut}}"
        bindtap="onLogout"
      >
        <text>退出登录</text>
      </button>
    </view>
  </block>
</view>
