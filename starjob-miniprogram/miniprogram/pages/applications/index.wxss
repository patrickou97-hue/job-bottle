.page-header {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.auth-state,
.state-panel {
  margin-top: 40rpx;
  padding: 50rpx 24rpx;
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
  text-align: center;
}

.orbit-symbol {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  border: 1rpx solid rgba(126, 124, 181, 0.35);
  border-radius: 50%;
}

.orbit-symbol::before {
  content: "";
  position: absolute;
  inset: 22rpx;
  border: 1rpx solid rgba(126, 124, 181, 0.2);
  border-radius: 50%;
}

.orbit-core {
  position: absolute;
  left: 41rpx;
  top: 41rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.state-title,
.state-copy {
  display: block;
}

.state-title {
  font-size: 31rpx;
  font-weight: 660;
}

.state-copy {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.state-action {
  width: 250rpx;
  margin: 28rpx auto 0;
}

.application-list {
  display: grid;
  gap: 16rpx;
  margin-top: 26rpx;
}

.application-row {
  width: 100%;
  padding: 26rpx;
  color: var(--color-ink);
  text-align: left;
}

.application-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.application-status {
  display: flex;
  align-items: center;
  color: #57558b;
  font-size: 21rpx;
  font-weight: 650;
}

.status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.application-date {
  color: var(--color-muted);
  font-size: 20rpx;
}

.application-company,
.application-role {
  display: block;
}

.application-company {
  margin-top: 20rpx;
  color: var(--color-ink-soft);
  font-size: 23rpx;
}

.application-role {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.35;
}

.application-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.row-arrow {
  color: #a1a1a6;
  font-size: 34rpx;
}

.application-skeleton {
  padding: 28rpx;
  border-radius: var(--radius-panel);
  background: var(--color-surface-strong);
}

.skeleton-company {
  width: 30%;
}

.skeleton-role {
  width: 70%;
  height: 34rpx;
  margin-top: 18rpx;
}

.skeleton-status {
  width: 50%;
  margin-top: 22rpx;
}
