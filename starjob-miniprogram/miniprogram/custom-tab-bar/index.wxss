.tab-bar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 104rpx;
  padding: 0 18rpx env(safe-area-inset-bottom);
  align-items: stretch;
  border-top: 1rpx solid rgba(18, 41, 78, 0.1);
  background: rgba(250, 250, 251, 0.98);
}

.tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  padding: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: transparent;
  color: #77777c;
  font-size: 21rpx;
  font-weight: 520;
  line-height: 1;
}

.tab-item::after {
  border: 0;
}

.tab-item-active {
  color: #12294e;
  font-weight: 650;
}

.tab-indicator {
  position: absolute;
  top: 13rpx;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: transparent;
  transform: translateX(-50%);
}

.tab-item-active .tab-indicator {
  background: #12294e;
}

.tab-item-pressed {
  background: rgba(18, 41, 78, 0.05);
}
