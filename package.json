{
  "name": "shi-xing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:extension": "node scripts/build_resume_extension.mjs",
    "build:extension:dev": "node scripts/build_resume_extension_dev.mjs",
    "start": "next start",
    "lint": "eslint",
    "prepare:typecheck": "node scripts/prepare_typecheck.mjs",
    "typecheck": "npm run prepare:typecheck && tsc --noEmit --incremental false",
    "test": "node --conditions=react-server --test tests/*.test.ts scripts/tests/*.test.mjs",
    "test:extension": "node scripts/test_extension_fixtures.mjs",
    "verify:extension-package": "node scripts/verify_resume_extension_package.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:extension && npm run verify:extension-package && npm --prefix starjob-miniprogram run check",
    "check:release": "npm run check && npm run build && npm run smoke",
    "smoke": "node scripts/smoke_check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "d3-geo": "^3.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "read-excel-file": "^9.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "description": "拾星是一个面向学生秋招投递的岗位星图与个人投递进度管理工具。界面采用全中文冷色星空职业图视觉：银蓝星轨、原创矢量星图、玻璃星瓶和独立管理后台。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickou97-hue/job-bottle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/patrickou97-hue/job-bottle/issues"
  },
  "homepage": "https://github.com/patrickou97-hue/job-bottle#readme"
}
